# Copy to .env (or paste into docker-compose) on the home server.
# Replace 192.168.1.50 with your server's LAN IP.

PORT=8096
GRAB_TOKEN=

NZBFINDER_URL=https://nzbfinder.ws
NZBFINDER_API_KEY=

# Host LAN IP — Roku, grab, NZBGet, and Plex all talk via this IP
NZBGET_URL=http://192.168.1.50:6789
NZBGET_USERNAME=
NZBGET_PASSWORD=
NZBGET_PRIORITY=900
# Dedicated categories recommended (DestDir = same folders as Movies / Series).
# Or set to Movies / Series if you prefer reusing the *arr categories.
NZBGET_CATEGORY_MOVIE=PlexFlix-Movies
NZBGET_CATEGORY_TV=PlexFlix-Series

MAX_SIZE_BYTES=5368709120
PREFER_RESOLUTION=1080p

PLEX_URL=http://192.168.1.50:32400
PLEX_TOKEN=
PLEX_MOVIE_SECTION_ID=
PLEX_TV_SECTION_ID=

SONARR_URL=http://192.168.1.50:8989
SONARR_API_KEY=
