# Example env for enrich_cable_epg.py
# Copy to the home server, fill in secrets, chmod 600.
#
#   cp roku/scripts/cable_epg.env.example ~/plexflix-cable-epg.env
#   chmod 600 ~/plexflix-cable-epg.env
#
# Builds plexflix/cable-epg.json — does NOT overwrite the sports feed.

# ---------------------------------------------------------------------------
# XMLTV source
# ---------------------------------------------------------------------------
# Free US national/cable dump (epgshare01 US2). Override if you self-host
# iptv-org/epg or another guide.xml / .xml.gz.
EPG_XMLTV_URL=https://epgshare01.online/epgshare01/epg_ripper_US2.xml.gz

# ---------------------------------------------------------------------------
# TMDB (optional but recommended)
# ---------------------------------------------------------------------------
# https://www.themoviedb.org/settings/api — API Key (v3 auth), not the v4 token.
# When set, unique programme titles get overview / backdrop / poster / cast.
# Results are cached so later runs mostly hit disk.
#
# Put comments on their own lines. Inline trailing comments on the VALUE line
# used to get glued into the key (and cause TMDB 401s).
TMDB_API_KEY=REPLACE_WITH_TMDB_API_KEY

# Optional override (default: ~/.cache/plexflix-cable-tmdb.json)
# TMDB_CACHE_PATH=/var/cache/plexflix/cable-tmdb.json

# ---------------------------------------------------------------------------
# Backblaze B2 (only needed with --upload)
# ---------------------------------------------------------------------------
# Use the SAME key/bucket that already publishes secretfeedfilename.json / splash.
# No region setting needed — b2sdk uses the native B2 API.
B2_BUCKET=roku-hockey
B2_KEY_ID=REPLACE_WITH_B2_KEY_ID
B2_APPLICATION_KEY=REPLACE_WITH_B2_APPLICATION_KEY

# Object key inside the bucket. Keep this SEPARATE from the sports feed.
B2_REMOTE_KEY=plexflix/cable-epg.json

# Optional: printed after upload for sanity-check (must match PlexConfig cableEpgUrl)
# B2_PUBLIC_URL=https://roku-hockey.s3.us-west-004.backblazeb2.com/plexflix/cable-epg.json
