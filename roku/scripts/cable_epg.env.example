# Example env for enrich_cable_epg.py
# Copy to the home server, fill in secrets, chmod 600.
#
#   cp roku/scripts/cable_epg.env.example ~/plexflix-cable-epg.env
#   chmod 600 ~/plexflix-cable-epg.env
#
# Builds plexflix/cable-epg.json — does NOT overwrite the sports feed.

# ---------------------------------------------------------------------------
# XMLTV source
# ---------------------------------------------------------------------------
# Free US national/cable dump (epgshare01 US2). Override if you self-host
# iptv-org/epg or another guide.xml / .xml.gz.
EPG_XMLTV_URL=https://epgshare01.online/epgshare01/epg_ripper_US2.xml.gz

# ---------------------------------------------------------------------------
# Backblaze B2 (only needed with --upload)
# ---------------------------------------------------------------------------
# Use the same bucket that already serves secretfeedfilename.json / splash.
B2_BUCKET=roku-hockey
B2_KEY_ID=REPLACE_WITH_B2_KEY_ID
B2_APPLICATION_KEY=REPLACE_WITH_B2_APPLICATION_KEY

# Object key inside the bucket. Keep this SEPARATE from the sports feed.
# Public URL becomes:
#   https://<your-b2-friendly-url>/plexflix/cable-epg.json
# Match that URL in PlexConfig.brs → cableEpgUrl
B2_REMOTE_KEY=plexflix/cable-epg.json
