# Example env for enrich_cable_epg.py (copy to your home server, chmod 600)

# Published sports feed the script downloads and re-uploads
SPORTS_FEED_URL=https://roku-hockey.s3.us-west-004.backblazeb2.com/secretfeedfilename.json

# Free US national/cable XMLTV dump (or point at your own iptv-org guide.xml / .gz)
EPG_XMLTV_URL=https://epgshare01.online/epgshare01/epg_ripper_US2.xml.gz

# Required only with --upload
B2_BUCKET=roku-hockey
B2_KEY_ID=REPLACE
B2_APPLICATION_KEY=REPLACE
B2_REMOTE_KEY=secretfeedfilename.json
