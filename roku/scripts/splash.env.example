# Example env for update_splash_posters.py (copy to your home server, chmod 600)
PLEX_BASE_URL=http://192.168.1.50:32400
PLEX_TOKEN=REPLACE_WITH_YOUR_PLEX_TOKEN

# Public URL prefix where Roku will fetch posters.json + images/
SPLASH_CDN_BASE=https://roku-hockey.s3.us-west-004.backblazeb2.com/plexflix/splash
SPLASH_OUT_DIR=/var/lib/plexflix/splash-out

# Optional — only needed with --upload
B2_BUCKET=roku-hockey
B2_KEY_ID=REPLACE
B2_APPLICATION_KEY=REPLACE
B2_REMOTE_PREFIX=plexflix/splash
