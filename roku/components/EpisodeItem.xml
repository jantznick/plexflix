<?xml version="1.0" encoding="utf-8" ?>
<component name="EpisodeItem" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="onContentChange" />
        <field id="focusPercent" type="float" onChange="onFocusPercentChange" />
        <field id="width" type="float" onChange="onSizeChange" />
        <field id="height" type="float" onChange="onSizeChange" />
        <!-- Set by the owning RowList; without it the ring stays lit on the
             selected episode even when Play or the sidebar holds focus -->
        <field id="rowListHasFocus" type="boolean" value="true" onChange="onOwnerFocusChange" />
        <!-- RowList keeps focusPercent=1 on every row's remembered item, so
             only the row that actually holds focus may light its ring -->
        <field id="rowHasFocus" type="boolean" value="true" onChange="onOwnerFocusChange" />
    </interface>

    <script type="text/brightscript" uri="EpisodeItem.brs" />

    <children>
        <!-- Focus chrome stays inside the RowList cell — negative offsets clip on device -->
        <Rectangle
            id="shadow"
            width="304"
            height="160"
            translation="[14, 14]"
            color="0x000000"
            opacity="0.4"
        />
        <Poster
            id="still"
            width="304"
            height="164"
            translation="[8, 8]"
            loadDisplayMode="scaleToZoom"
            failedBitmapUri="pkg:/images/poster_placeholder.png"
            loadingBitmapUri="pkg:/images/poster_placeholder.png"
            uri="pkg:/images/poster_placeholder.png"
            opacity="0.78"
        />
        <Rectangle
            id="titleScrim"
            width="304"
            height="52"
            translation="[8, 120]"
            color="0x000000"
            opacity="0.7"
        />
        <Label
            id="titleLabel"
            translation="[20, 128]"
            width="280"
            height="40"
            color="0xFFFFFF"
            wrap="true"
            maxLines="2"
        >
            <Font role="font" uri="pkg:/fonts/Outfit-Medium.ttf" size="18" />
        </Label>

        <Rectangle
            id="progressBg"
            width="304"
            height="8"
            translation="[8, 164]"
            color="0x000000"
            opacity="0.65"
            visible="false"
        />
        <Rectangle
            id="progressFg"
            width="0"
            height="8"
            translation="[8, 164]"
            color="0xE50914"
            visible="false"
        />
        <Poster
            id="watchedBadge"
            width="34"
            height="34"
            translation="[270, 16]"
            uri="pkg:/images/watched_check.png"
            visible="false"
        />

        <!-- Accent first so the white sides always draw over it -->
        <Group id="focusChrome" visible="false">
            <Rectangle id="focusAccent" width="312" height="4" translation="[4, 172]" color="0xE50914" />
            <Rectangle id="ringT" width="320" height="4" translation="[0, 0]" color="0xFFFFFF" />
            <Rectangle id="ringB" width="320" height="4" translation="[0, 176]" color="0xFFFFFF" />
            <Rectangle id="ringL" width="4" height="180" translation="[0, 0]" color="0xFFFFFF" />
            <Rectangle id="ringR" width="4" height="180" translation="[316, 0]" color="0xFFFFFF" />
        </Group>
    </children>
</component>
