<?xml version="1.0" encoding="utf-8" ?>
<component name="ProfilePickerScreen" extends="Group">
    <interface>
        <field id="config" type="assocarray" />
        <field id="selectedProfile" type="assocarray" alwaysNotify="true" />
    </interface>

    <script type="text/brightscript" uri="ProfilePickerScreen.brs" />
    <script type="text/brightscript" uri="pkg:/source/Fonts.brs" />
    <script type="text/brightscript" uri="pkg:/source/Profiles.brs" />

    <children>
        <!-- Atmospheric plane - not a flat fill -->
        <Rectangle width="1920" height="1080" color="0x0B1220" />
        <Rectangle width="1920" height="1080" color="0x132033" opacity="0.85" />
        <Rectangle translation="[0, 0]" width="1920" height="420" color="0x1A3A3A" opacity="0.22" />
        <Rectangle translation="[0, 720]" width="1920" height="360" color="0x0A0E18" opacity="0.55" />
        <Poster
            translation="[1100, -80]"
            width="980"
            height="980"
            uri="pkg:/images/poster_placeholder.png"
            opacity="0.06"
            loadDisplayMode="scaleToZoom"
        />

        <Group id="hero" translation="[0, 0]">
            <Label id="brand" translation="[120, 96]" width="1680" height="72" text="PlexFlix" color="0xFFFFFF">
                <Font role="font" uri="pkg:/fonts/Outfit-Bold.ttf" size="64" />
            </Label>
            <Label id="headline" translation="[120, 178]" width="1680" height="56" text="Who is watching?" color="0xE8EEF8">
                <Font role="font" uri="pkg:/fonts/Outfit-SemiBold.ttf" size="42" />
            </Label>
            <Label id="tagline" translation="[120, 240]" width="900" height="40" text="Pick a profile to personalize libraries and live TV." color="0x8FA0B8">
                <Font role="font" uri="pkg:/fonts/Outfit-Regular.ttf" size="26" />
            </Label>
        </Group>

        <Group id="profileRow" translation="[0, 360]" />

        <Label id="hint" translation="[120, 980]" width="1680" height="36" text="OK to select  |  Left / Right to move" color="0x5E6880" horizAlign="center">
            <Font role="font" uri="pkg:/fonts/Outfit-Medium.ttf" size="22" />
        </Label>

        <!-- PIN overlay -->
        <Group id="pinOverlay" visible="false">
            <Rectangle width="1920" height="1080" color="0x05070C" opacity="0.72" />
            <Rectangle id="pinPanel" translation="[560, 280]" width="800" height="480" color="0x121A2A" />
            <Rectangle translation="[560, 280]" width="8" height="480" color="0xE50914" />
            <Label id="pinTitle" translation="[608, 320]" width="704" height="48" text="Enter passcode" color="0xFFFFFF">
                <Font role="font" uri="pkg:/fonts/Outfit-Bold.ttf" size="36" />
            </Label>
            <Label id="pinSub" translation="[608, 372]" width="704" height="36" text="Adults profile" color="0x8FA0B8">
                <Font role="font" uri="pkg:/fonts/Outfit-Regular.ttf" size="24" />
            </Label>
            <Group id="pinDigits" translation="[680, 460]" />
            <Label id="pinError" translation="[608, 580]" width="704" height="36" text="" color="0xFF5A64" horizAlign="center">
                <Font role="font" uri="pkg:/fonts/Outfit-Medium.ttf" size="22" />
            </Label>
            <Label id="pinHint" translation="[608, 680]" width="704" height="36" text="Numbers or Up/Down | Right next | OK unlock | Back cancel" color="0x5E6880" horizAlign="center">
                <Font role="font" uri="pkg:/fonts/Outfit-Regular.ttf" size="20" />
            </Label>
        </Group>
    </children>
</component>
