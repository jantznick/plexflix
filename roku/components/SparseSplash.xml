<?xml version="1.0" encoding="utf-8" ?>
<component name="SparseSplash" extends="Group">
    <interface>
        <field id="active" type="boolean" value="false" onChange="onActiveChange" />
        <field id="manifestUrl" type="string" value="" onChange="onManifestUrlChange" />
    </interface>

    <script type="text/brightscript" uri="SparseSplash.brs" />
    <script type="text/brightscript" uri="pkg:/source/Spinner.brs" />

    <children>
        <Rectangle width="1920" height="1080" color="0x07070B" />
        <Group id="posterLayer" />
        <Rectangle width="1920" height="1080" color="0x07070B" opacity="0.38" />
        <Rectangle width="1920" height="280" translation="[0, 400]" color="0x07070B" opacity="0.5" />
        <Poster
            id="brandLogo"
            translation="[660, 430]"
            width="600"
            height="166"
            loadDisplayMode="scaleToFit"
            uri="pkg:/images/loading-logo.png"
        />
        <BusySpinner id="spinner" translation="[912, 680]" uri="pkg:/images/spinner.png" />
    </children>
</component>
