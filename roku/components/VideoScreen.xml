<?xml version="1.0" encoding="utf-8" ?>
<component name="VideoScreen" extends="Group">
    <interface>
        <field id="config" type="assocarray" />
        <field id="content" type="assocarray" onChange="onContentSet" />
        <field id="closed" type="boolean" alwaysNotify="true" />
        <field id="close" type="boolean" alwaysNotify="true" onChange="onCloseRequested" />
        <!-- Plex calls are handed to MainScene rather than run here: the last
             ones fire as this screen is torn down and a Task owned by a node
             that is going away can be collected before it finishes -->
        <field id="playbackReport" type="assocarray" alwaysNotify="true" />
    </interface>

    <script type="text/brightscript" uri="VideoScreen.brs" />

    <children>
        <Timer id="hideTimer" duration="5" repeat="false" />
        <Timer id="seekTimer" duration="0.7" repeat="false" />
        <Timer id="reportTimer" duration="10" repeat="true" />

        <Animation id="fade" duration="0.22" easeFunction="outQuad">
            <FloatFieldInterpolator id="fadeInterp" key="[0.0, 1.0]" keyValue="[0.0, 1.0]" fieldToInterp="controls.opacity" />
        </Animation>

        <Rectangle width="1920" height="1080" color="0x000000" />

        <!-- enableUI="false": every control below is ours, so Roku's stock
             trick-play overlay must stay out of the way. Focus also stays on
             this Group rather than the Video node so one key handler owns the
             remote for the whole screen. -->
        <Video
            id="video"
            width="1920"
            height="1080"
            enableUI="false"
            notificationInterval="1"
        />

        <Label
            id="statusLabel"
            width="1920"
            height="60"
            translation="[0, 500]"
            horizAlign="center"
            color="0xFFFFFF"
            font="font:MediumSystemFont"
            text="Starting playback..."
        />
        <BusySpinner id="spinner" translation="[920, 580]" uri="pkg:/images/spinner.png" visible="false" />

        <Group id="controls" visible="false" opacity="0">
            <Poster
                id="scrim"
                width="1920"
                height="560"
                translation="[0, 520]"
                loadDisplayMode="scaleToFill"
                uri="pkg:/images/player_scrim.png"
            />

            <Group id="castPanel" translation="[96, 548]" visible="false">
                <Label id="castHeading" width="400" height="26" text="Cast" color="0x9A9AA4">
                    <Font role="font" uri="pkg:/fonts/Outfit-Medium.ttf" size="20" />
                </Label>
                <Group id="castRow" translation="[0, 32]" />
            </Group>

            <Label id="titleLabel" width="1500" height="48" translation="[96, 782]" color="0xFFFFFF">
                <Font role="font" uri="pkg:/fonts/Outfit-Bold.ttf" size="38" />
            </Label>
            <Label id="subtitleLabel" width="1500" height="34" translation="[96, 836]" color="0xB8B8C4">
                <Font role="font" uri="pkg:/fonts/Outfit-Medium.ttf" size="24" />
            </Label>

            <!-- After the title labels so it draws over them: the preview wants
                 the same strip of screen and only appears while scrubbing -->
            <Rectangle id="previewFrame" width="326" height="186" translation="[96, 691]" color="0xFFFFFF" visible="false" />
            <Poster id="previewImage" width="320" height="180" translation="[99, 694]" loadDisplayMode="scaleToFill" visible="false" />

            <Rectangle id="track" width="1728" height="8" translation="[96, 894]" color="0x45454F" />
            <Rectangle id="fill" width="0" height="8" translation="[96, 894]" color="0xE50914" />
            <Rectangle id="thumb" width="8" height="26" translation="[96, 885]" color="0xFFFFFF" />

            <Label id="elapsedLabel" width="1728" height="30" translation="[96, 916]" horizAlign="left" color="0xFFFFFF">
                <Font role="font" uri="pkg:/fonts/Outfit-Medium.ttf" size="22" />
            </Label>
            <Label id="endsAtLabel" width="1728" height="30" translation="[96, 916]" horizAlign="center" color="0x9A9AA4">
                <Font role="font" uri="pkg:/fonts/Outfit-Medium.ttf" size="22" />
            </Label>
            <Label id="remainingLabel" width="1728" height="30" translation="[96, 916]" horizAlign="right" color="0xFFFFFF">
                <Font role="font" uri="pkg:/fonts/Outfit-Medium.ttf" size="22" />
            </Label>

            <Group id="buttonRow" translation="[96, 960]" />
        </Group>

        <!-- Outside the controls group: while a marker is live this is the one
             thing worth putting on screen without the whole panel -->
        <Group id="skipPill" translation="[1524, 940]" visible="false">
            <Rectangle width="300" height="64" color="0x000000" opacity="0.72" />
            <Rectangle width="300" height="4" color="0xE50914" />
            <Label id="skipLabel" width="300" height="64" horizAlign="center" vertAlign="center" color="0xFFFFFF">
                <Font role="font" uri="pkg:/fonts/Outfit-SemiBold.ttf" size="26" />
            </Label>
        </Group>

        <Group id="picker" visible="false">
            <Rectangle width="1920" height="1080" color="0x000000" opacity="0.6" />
            <Rectangle translation="[600, 230]" width="720" height="620" color="0x14141C" />
            <Rectangle translation="[600, 230]" width="720" height="4" color="0xE50914" />
            <Label id="pickerTitle" translation="[640, 260]" width="640" height="44" color="0xFFFFFF">
                <Font role="font" uri="pkg:/fonts/Outfit-Bold.ttf" size="32" />
            </Label>
            <Group id="pickerRows" translation="[620, 320]" />
        </Group>

        <!-- Cast details without leaving playback: the video pauses behind the
             panel and resumes on close if it was playing when this opened -->
        <Group id="castModal" visible="false">
            <Rectangle width="1920" height="1080" color="0x000000" opacity="0.72" />
            <Rectangle translation="[300, 250]" width="1320" height="580" color="0x14141C" />
            <Rectangle translation="[300, 250]" width="1320" height="4" color="0xE50914" />

            <Poster
                id="castModalPhoto"
                width="220"
                height="330"
                translation="[348, 300]"
                loadDisplayMode="scaleToZoom"
                failedBitmapUri="pkg:/images/poster_placeholder.png"
                uri="pkg:/images/poster_placeholder.png"
            />

            <Label id="castModalName" translation="[604, 302]" width="968" height="52" color="0xFFFFFF">
                <Font role="font" uri="pkg:/fonts/Outfit-Bold.ttf" size="40" />
            </Label>
            <Label id="castModalRole" translation="[604, 360]" width="968" height="34" color="0xE50914">
                <Font role="font" uri="pkg:/fonts/Outfit-Medium.ttf" size="24" />
            </Label>
            <Label id="castModalMeta" translation="[604, 400]" width="968" height="32" color="0x9A9AA4">
                <Font role="font" uri="pkg:/fonts/Outfit-Medium.ttf" size="22" />
            </Label>
            <Label id="castModalBio" translation="[604, 444]" width="968" height="186" wrap="true" maxLines="6" color="0xD8D8E0">
                <Font role="font" uri="pkg:/fonts/Outfit-Regular.ttf" size="22" />
            </Label>
            <Label id="castModalKnownFor" translation="[604, 642]" width="968" height="32" color="0x9A9AA4">
                <Font role="font" uri="pkg:/fonts/Outfit-Medium.ttf" size="22" />
            </Label>
            <BusySpinner id="castModalSpinner" translation="[940, 520]" uri="pkg:/images/spinner.png" visible="false" />
        </Group>
    </children>
</component>
