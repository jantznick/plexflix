<?xml version="1.0" encoding="utf-8" ?>
<component name="LibraryBrowseScreen" extends="Group">
    <interface>
        <field id="config" type="assocarray" />
        <field id="source" type="assocarray" onChange="onSourceSet" />
        <field id="selectedItem" type="assocarray" />
        <field id="viewAllRequested" type="assocarray" alwaysNotify="true" />
        <field id="closed" type="boolean" alwaysNotify="true" />
        <field id="close" type="boolean" alwaysNotify="true" onChange="onCloseRequested" />
        <field id="loadingMessage" type="string" />
        <field id="openMenu" type="boolean" alwaysNotify="true" />
        <field id="refocus" type="boolean" alwaysNotify="true" onChange="onRefocus" />
        <!-- Set while another screen is on top so this one stops grabbing focus -->
        <field id="suspended" type="boolean" onChange="onSuspendedChange" />
    </interface>

    <script type="text/brightscript" uri="LibraryBrowseScreen.brs" />
    <script type="text/brightscript" uri="pkg:/source/Fonts.brs" />

    <children>
        <Rectangle width="1920" height="1080" color="0x07070B" />

        <!-- Dense mosaic fills the hero band only — tiles filled at runtime -->
        <Group id="mosaicClip" clippingRect="[0, 0, 1920, 460]">
            <Group id="mosaic" translation="[0, 0]" />
        </Group>
        <Rectangle width="1920" height="460" color="0x07070B" opacity="0.42" />
        <Rectangle width="980" height="460" color="0x07070B" opacity="0.72" />
        <!-- Stepped wash so the clipped mosaic edge reads as a fade, not a seam -->
        <Rectangle translation="[0, 380]" width="1920" height="30" color="0x07070B" opacity="0.45" />
        <Rectangle translation="[0, 410]" width="1920" height="25" color="0x07070B" opacity="0.7" />
        <Rectangle translation="[0, 435]" width="1920" height="25" color="0x07070B" opacity="0.88" />

        <Group id="hero" translation="[0, 0]">
            <Label id="titleLabel" translation="[96, 48]" width="860" height="70" text="Library" color="0xFFFFFF" wrap="true" maxLines="2">
                <Font role="font" uri="pkg:/fonts/Outfit-Bold.ttf" size="52" />
            </Label>
            <Label id="heroHint" translation="[96, 124]" width="820" height="60" text="Browse everything in this library." color="0xC8C8D0" wrap="true" maxLines="2">
                <Font role="font" uri="pkg:/fonts/Outfit-Regular.ttf" size="22" />
            </Label>

            <Group id="viewAllBtn" translation="[96, 210]">
                <Rectangle id="viewAllBg" width="280" height="60" color="0x2A2A32" />
                <Label id="viewAllLabel" width="280" height="60" horizAlign="center" vertAlign="center" text="View all" color="0xFFFFFF">
                    <Font role="font" uri="pkg:/fonts/Outfit-SemiBold.ttf" size="28" />
                </Label>
            </Group>
            <Group id="searchBtn" translation="[392, 210]">
                <Rectangle id="searchBg" width="240" height="60" color="0x2A2A32" />
                <Label id="searchLabel" width="240" height="60" horizAlign="center" vertAlign="center" text="Search" color="0xFFFFFF">
                    <Font role="font" uri="pkg:/fonts/Outfit-SemiBold.ttf" size="28" />
                </Label>
            </Group>

            <Label id="statusLabel" translation="[96, 292]" width="1000" height="32" text="" color="0x9A9AA4">
                <Font role="font" uri="pkg:/fonts/Outfit-Regular.ttf" size="20" />
            </Label>
        </Group>

        <ShimmerRow id="shimmer" translation="[96, 480]" />

        <ShelfRowList
            id="rowList"
            translation="[96, 480]"
            itemComponentName="PosterItem"
            numRows="2"
            rowItemSize="[[150, 225]]"
            rowItemSpacing="[[22, 0]]"
            itemSize="[1728, 280]"
            itemSpacing="[0, 16]"
            showRowLabel="[true]"
            rowLabelOffset="[[0, 4]]"
            rowFocusAnimationStyle="fixedFocus"
            focusXOffset="[0]"
            drawFocusFeedback="false"
            visible="false"
        />
    </children>
</component>
