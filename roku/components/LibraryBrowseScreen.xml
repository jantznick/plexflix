<?xml version="1.0" encoding="utf-8" ?>
<component name="LibraryBrowseScreen" extends="Group">
    <interface>
        <field id="config" type="assocarray" />
        <field id="source" type="assocarray" onChange="onSourceSet" />
        <field id="selectedItem" type="assocarray" />
        <field id="viewAllRequested" type="assocarray" alwaysNotify="true" />
        <field id="closed" type="boolean" alwaysNotify="true" />
        <field id="close" type="boolean" alwaysNotify="true" onChange="onCloseRequested" />
        <field id="loadingMessage" type="string" />
        <field id="openMenu" type="boolean" alwaysNotify="true" />
        <field id="refocus" type="boolean" alwaysNotify="true" onChange="onRefocus" />
    </interface>

    <script type="text/brightscript" uri="LibraryBrowseScreen.brs" />
    <script type="text/brightscript" uri="pkg:/source/Fonts.brs" />

    <children>
        <Rectangle width="1920" height="1080" color="0x07070B" />

        <Group id="hero" translation="[0, 0]">
            <Rectangle width="1920" height="420" color="0x121218" />
            <Poster id="tile0" translation="[96, 40]" width="180" height="270" loadDisplayMode="scaleToZoom" uri="pkg:/images/poster_placeholder.png" opacity="0.85" />
            <Poster id="tile1" translation="[292, 64]" width="160" height="240" loadDisplayMode="scaleToZoom" uri="pkg:/images/poster_placeholder.png" opacity="0.75" />
            <Poster id="tile2" translation="[468, 36]" width="190" height="285" loadDisplayMode="scaleToZoom" uri="pkg:/images/poster_placeholder.png" opacity="0.9" />
            <Poster id="tile3" translation="[674, 72]" width="150" height="225" loadDisplayMode="scaleToZoom" uri="pkg:/images/poster_placeholder.png" opacity="0.7" />
            <Poster id="tile4" translation="[840, 48]" width="170" height="255" loadDisplayMode="scaleToZoom" uri="pkg:/images/poster_placeholder.png" opacity="0.8" />
            <Poster id="tile5" translation="[1028, 80]" width="150" height="225" loadDisplayMode="scaleToZoom" uri="pkg:/images/poster_placeholder.png" opacity="0.65" />
            <Poster id="tile6" translation="[1194, 40]" width="190" height="285" loadDisplayMode="scaleToZoom" uri="pkg:/images/poster_placeholder.png" opacity="0.85" />
            <Poster id="tile7" translation="[1400, 68]" width="160" height="240" loadDisplayMode="scaleToZoom" uri="pkg:/images/poster_placeholder.png" opacity="0.75" />
            <Rectangle width="1920" height="420" color="0x07070B" opacity="0.5" />
            <Rectangle width="900" height="420" color="0x07070B" opacity="0.7" />

            <Label id="titleLabel" translation="[96, 56]" width="820" height="70" text="Library" color="0xFFFFFF" wrap="true" maxLines="2">
                <Font role="font" uri="pkg:/fonts/Outfit-Bold.ttf" size="52" />
            </Label>
            <Label id="heroHint" translation="[96, 132]" width="780" height="60" text="Browse everything in this library." color="0xC8C8D0" wrap="true" maxLines="2">
                <Font role="font" uri="pkg:/fonts/Outfit-Regular.ttf" size="22" />
            </Label>

            <Group id="viewAllBtn" translation="[96, 220]">
                <Rectangle id="viewAllBg" width="280" height="60" color="0xE50914" />
                <Label width="280" height="60" horizAlign="center" vertAlign="center" text="View all" color="0xFFFFFF">
                    <Font role="font" uri="pkg:/fonts/Outfit-SemiBold.ttf" size="28" />
                </Label>
            </Group>
            <Label id="statusLabel" translation="[96, 300]" width="900" height="32" text="" color="0x777780">
                <Font role="font" uri="pkg:/fonts/Outfit-Regular.ttf" size="20" />
            </Label>
        </Group>

        <ShimmerRow id="shimmer" translation="[96, 460]" />

        <ShelfRowList
            id="rowList"
            translation="[96, 460]"
            itemComponentName="PosterItem"
            numRows="2"
            rowItemSize="[[150, 225]]"
            rowItemSpacing="[[22, 0]]"
            itemSize="[1728, 280]"
            itemSpacing="[0, 16]"
            showRowLabel="[true]"
            rowLabelOffset="[[0, 4]]"
            rowFocusAnimationStyle="fixedFocus"
            focusXOffset="[0]"
            drawFocusFeedback="false"
            visible="false"
        />
    </children>
</component>
