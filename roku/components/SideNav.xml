<?xml version="1.0" encoding="utf-8" ?>
<component name="SideNav" extends="Group">
    <interface>
        <field id="selected" type="string" alwaysNotify="true" />
        <field id="active" type="string" onChange="onActiveChange" value="home" />
        <field id="expanded" type="boolean" value="false" onChange="onExpandedChange" />
    </interface>

    <script type="text/brightscript" uri="SideNav.brs" />

    <children>
        <Rectangle id="rail" width="252" height="1080" color="0x0C0C10" opacity="0.96" />
        <Rectangle width="252" height="1080" color="0x000000" opacity="0.35" />
        <Rectangle width="1" height="1080" translation="[251, 0]" color="0xFFFFFF" opacity="0.08" />

        <Label
            translation="[32, 52]"
            width="188"
            height="44"
            text="PLEXFLIX"
            color="0xE50914"
            font="font:MediumBoldSystemFont"
        />

        <Group id="homeItem" translation="[20, 150]">
            <Rectangle id="homeBg" width="212" height="58" color="0xE50914" />
            <Label width="212" height="58" horizAlign="center" vertAlign="center" text="Home" color="0xFFFFFF" font="font:SmallBoldSystemFont" />
        </Group>
        <Group id="sourcesItem" translation="[20, 224]">
            <Rectangle id="sourcesBg" width="212" height="58" color="0x1E1E24" />
            <Label width="212" height="58" horizAlign="center" vertAlign="center" text="Libraries" color="0xDDDDDD" font="font:SmallSystemFont" />
        </Group>
        <Group id="sportsItem" translation="[20, 298]">
            <Rectangle id="sportsBg" width="212" height="58" color="0x1E1E24" />
            <Label width="212" height="58" horizAlign="center" vertAlign="center" text="Live Sports" color="0xDDDDDD" font="font:SmallSystemFont" />
        </Group>
    </children>
</component>
