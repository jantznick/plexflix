<?xml version="1.0" encoding="utf-8" ?>
<component name="SideNav" extends="Group">
    <interface>
        <field id="selected" type="string" alwaysNotify="true" />
        <field id="active" type="string" onChange="onActiveChange" value="home" />
    </interface>

    <script type="text/brightscript" uri="SideNav.brs" />

    <children>
        <Rectangle id="rail" width="280" height="1080" color="0x101014" />
        <Rectangle width="2" height="1080" translation="[278, 0]" color="0x2A2A2E" />

        <Label
            translation="[28, 36]"
            width="220"
            height="48"
            text="PLEXFLIX"
            color="0xE50914"
            font="font:MediumBoldSystemFont"
        />

        <Group id="homeItem" translation="[16, 140]">
            <Rectangle id="homeBg" width="248" height="64" color="0xE50914" />
            <Label width="248" height="64" horizAlign="center" vertAlign="center" text="Home" color="0xFFFFFF" font="font:SmallBoldSystemFont" />
        </Group>
        <Group id="playlistsItem" translation="[16, 220]">
            <Rectangle id="playlistsBg" width="248" height="64" color="0x1A1A1E" />
            <Label width="248" height="64" horizAlign="center" vertAlign="center" text="Playlists" color="0xDDDDDD" font="font:SmallSystemFont" />
        </Group>
        <Group id="sportsItem" translation="[16, 300]">
            <Rectangle id="sportsBg" width="248" height="64" color="0x1A1A1E" />
            <Label width="248" height="64" horizAlign="center" vertAlign="center" text="Live Sports" color="0xDDDDDD" font="font:SmallSystemFont" />
        </Group>
    </children>
</component>
