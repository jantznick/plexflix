<?xml version="1.0" encoding="utf-8" ?>
<component name="SideNav" extends="Group">
    <interface>
        <field id="config" type="assocarray" onChange="onConfigReady" />
        <field id="selected" type="string" alwaysNotify="true" />
        <field id="selectedLibrary" type="assocarray" alwaysNotify="true" />
        <field id="active" type="string" onChange="onActiveChange" value="home" />
        <field id="expanded" type="boolean" value="false" onChange="onExpandedChange" />
    </interface>

    <script type="text/brightscript" uri="SideNav.brs" />
    <script type="text/brightscript" uri="pkg:/source/Fonts.brs" />

    <children>
        <Rectangle id="rail" width="300" height="1080" color="0x121218" />
        <Rectangle width="1" height="1080" translation="[299, 0]" color="0xFFFFFF" opacity="0.12" />

        <Poster
            id="brandLogo"
            translation="[28, 40]"
            width="244"
            height="68"
            loadDisplayMode="scaleToFit"
            uri="pkg:/images/loading-logo.png"
        />

        <Group id="navItems" translation="[20, 130]" />

        <Label id="versionLabel" translation="[36, 1020]" width="228" height="32" text="v0.9.0" color="0x55555A">
            <Font role="font" uri="pkg:/fonts/Outfit-Medium.ttf" size="16" />
        </Label>
    </children>
</component>
