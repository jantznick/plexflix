<?xml version="1.0" encoding="utf-8" ?>
<component name="WatchlistScreen" extends="Group">
    <interface>
        <field id="config" type="assocarray" onChange="onConfigReady" />
        <field id="selectedItem" type="assocarray" />
        <field id="closed" type="boolean" alwaysNotify="true" />
        <field id="close" type="boolean" alwaysNotify="true" onChange="onCloseRequested" />
        <field id="loadingMessage" type="string" />
        <field id="openMenu" type="boolean" alwaysNotify="true" />
        <field id="refocus" type="boolean" alwaysNotify="true" onChange="onRefocus" />
        <field id="refresh" type="boolean" alwaysNotify="true" onChange="onRefresh" />
    </interface>

    <script type="text/brightscript" uri="WatchlistScreen.brs" />
    <script type="text/brightscript" uri="pkg:/source/Fonts.brs" />
    <script type="text/brightscript" uri="pkg:/source/Spinner.brs" />

    <children>
        <Rectangle width="1920" height="1080" color="0x07070B" />

        <Group id="header" translation="[96, 24]">
            <Label id="titleLabel" translation="[0, 2]" width="900" height="44" text="Watchlist" color="0xFFFFFF">
                <Font role="font" uri="pkg:/fonts/Outfit-Bold.ttf" size="32" />
            </Label>
            <Label id="metaLabel" translation="[0, 52]" width="1200" height="28" text="Titles you’ve saved on Plex" color="0x9A9AA4">
                <Font role="font" uri="pkg:/fonts/Outfit-Regular.ttf" size="18" />
            </Label>
            <FocusButton id="refreshBtn" translation="[1388, 0]" text="Refresh" buttonWidth="160" />
        </Group>

        <MarkupGrid
            id="grid"
            translation="[96, 108]"
            itemComponentName="PosterItem"
            itemSize="[240, 276]"
            itemSpacing="[30, 18]"
            numColumns="6"
            numRows="3"
            vertFocusAnimationStyle="floatingFocus"
            drawFocusFeedback="true"
            drawFocusFeedbackOnTop="true"
            focusBitmapUri="pkg:/images/focus_ring.9.png"
            focusFootprintBlendColor="0x00000000"
        />

        <Label id="emptyLabel" translation="[96, 420]" width="1728" height="160" text="" horizAlign="center" wrap="true" maxLines="4" color="0xC8C8D0" visible="false">
            <Font role="font" uri="pkg:/fonts/Outfit-Medium.ttf" size="28" />
        </Label>

        <BusySpinner id="spinner" translation="[912, 520]" uri="pkg:/images/spinner.png" visible="false" />
    </children>
</component>
