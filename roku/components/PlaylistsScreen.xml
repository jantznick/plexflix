<?xml version="1.0" encoding="utf-8" ?>
<component name="PlaylistsScreen" extends="Group">
    <interface>
        <field id="config" type="assocarray" onChange="onConfigReady" />
        <field id="selectedItem" type="assocarray" />
        <field id="loadingMessage" type="string" />
    </interface>

    <script type="text/brightscript" uri="PlaylistsScreen.brs" />

    <children>
        <Rectangle width="1640" height="1080" color="0x08080A" />
        <Label translation="[48, 40]" width="800" height="50" text="Playlists" color="0xFFFFFF" font="font:LargeBoldSystemFont" />
        <Label id="statusLabel" translation="[48, 100]" width="1500" height="40" text="Loading playlists..." color="0xAAAAAA" font="font:SmallSystemFont" />

        <LabelList
            id="playlistList"
            translation="[48, 160]"
            itemSize="[520, 56]"
            itemSpacing="[0, 8]"
            numRows="12"
            color="0xCCCCCC"
            focusedColor="0xFFFFFF"
            drawFocusFeedback="true"
        />

        <RowList
            id="itemsRow"
            translation="[0, 160]"
            itemComponentName="PosterItem"
            numRows="2"
            rowItemSize="[[180, 270]]"
            rowItemSpacing="[[24, 0]]"
            itemSize="[1100, 340]"
            itemSpacing="[0, 24]"
            showRowLabel="[true]"
            rowLabelOffset="[[600, 8]]"
            focusXOffset="[600]"
            drawFocusFeedback="false"
        />
    </children>
</component>
