<?xml version="1.0" encoding="utf-8" ?>
<component name="PosterItem" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="onContentChange" />
        <field id="focusPercent" type="float" onChange="onFocusPercentChange" />
    </interface>

    <script type="text/brightscript" uri="PosterItem.brs" />

    <children>
        <Poster
            id="poster"
            width="210"
            height="315"
            loadDisplayMode="scaleToZoom"
            uri="pkg:/images/poster_placeholder.png"
        />
        <Rectangle
            id="progressBg"
            width="210"
            height="6"
            translation="[0, 309]"
            color="0x404040"
            visible="false"
        />
        <Rectangle
            id="progressFg"
            width="0"
            height="6"
            translation="[0, 309]"
            color="0xE50914"
            visible="false"
        />
        <Label
            id="titleLabel"
            width="210"
            height="40"
            translation="[0, 320]"
            color="0xFFFFFF"
            font="font:SmallestSystemFont"
            horizAlign="center"
            wrap="true"
            maxLines="2"
            visible="false"
        />
    </children>
</component>