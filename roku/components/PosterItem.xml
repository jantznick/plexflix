<?xml version="1.0" encoding="utf-8" ?>
<component name="PosterItem" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="onContentChange" />
        <field id="focusPercent" type="float" onChange="onFocusPercentChange" />
        <field id="width" type="float" onChange="onSizeChange" />
        <field id="height" type="float" onChange="onSizeChange" />
    </interface>

    <script type="text/brightscript" uri="PosterItem.brs" />

    <children>
        <Poster
            id="poster"
            width="180"
            height="270"
            loadDisplayMode="scaleToZoom"
            failedBitmapUri="pkg:/images/poster_placeholder.png"
            loadingBitmapUri="pkg:/images/poster_placeholder.png"
            uri="pkg:/images/poster_placeholder.png"
            opacity="0.75"
        />

        <Rectangle id="focusTop" width="188" height="4" translation="[-4, -4]" color="0xFFFFFF" visible="false" />
        <Rectangle id="focusBottom" width="188" height="4" translation="[-4, 270]" color="0xFFFFFF" visible="false" />
        <Rectangle id="focusLeft" width="4" height="278" translation="[-4, -4]" color="0xFFFFFF" visible="false" />
        <Rectangle id="focusRight" width="4" height="278" translation="[180, -4]" color="0xFFFFFF" visible="false" />
        <Rectangle id="focusAccent" width="188" height="4" translation="[-4, 270]" color="0xE50914" visible="false" />

        <Rectangle
            id="progressBg"
            width="180"
            height="5"
            translation="[0, 265]"
            color="0x404040"
            visible="false"
        />
        <Rectangle
            id="progressFg"
            width="0"
            height="5"
            translation="[0, 265]"
            color="0xE50914"
            visible="false"
        />
    </children>
</component>
