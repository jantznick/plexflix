<?xml version="1.0" encoding="utf-8" ?>
<component name="PosterItem" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="onContentChange" />
        <field id="focusPercent" type="float" onChange="onFocusPercentChange" />
        <field id="width" type="float" onChange="onSizeChange" />
        <field id="height" type="float" onChange="onSizeChange" />
        <field id="rowIndex" type="integer" onChange="onRowIndexChange" />
        <field id="index" type="integer" />
        <!-- Set by the owning grid/list; without these the ring stays lit on the
             selected poster even when the toolbar or sidebar holds focus -->
        <field id="gridHasFocus" type="boolean" value="true" onChange="onOwnerFocusChange" />
        <field id="rowListHasFocus" type="boolean" value="true" onChange="onOwnerFocusChange" />
        <!-- RowList keeps focusPercent=1 on every row's remembered item, so
             only the row that actually holds focus may light its ring -->
        <field id="rowHasFocus" type="boolean" value="true" onChange="onOwnerFocusChange" />
    </interface>

    <script type="text/brightscript" uri="PosterItem.brs" />

    <children>
        <!-- The focus border is the owning list's native indicator
             (focus_ring.9.png), drawn on the cell edge; art is inset so it
             never covers the border -->
        <Group id="visual">
            <Rectangle
                id="shadow"
                width="152"
                height="228"
                translation="[14, 14]"
                color="0x000000"
                opacity="0.4"
            />
            <Rectangle
                id="cardBg"
                width="152"
                height="228"
                translation="[8, 8]"
                color="0x16161E"
            />
            <Poster
                id="poster"
                width="152"
                height="228"
                translation="[8, 8]"
                loadDisplayMode="scaleToZoom"
                failedBitmapUri="pkg:/images/poster_placeholder.png"
                loadingBitmapUri="pkg:/images/poster_placeholder.png"
                uri="pkg:/images/poster_placeholder.png"
                opacity="0.78"
            />

            <Rectangle
                id="progressBg"
                width="152"
                height="8"
                translation="[8, 228]"
                color="0x000000"
                opacity="0.65"
                visible="false"
            />
            <Rectangle
                id="progressFg"
                width="0"
                height="8"
                translation="[8, 228]"
                color="0xE50914"
                visible="false"
            />

            <!-- Watched tick and unwatched-episode count share the top-right
                 corner; a title can never be in both states at once -->
            <Poster
                id="watchedBadge"
                width="34"
                height="34"
                translation="[118, 16]"
                uri="pkg:/images/watched_check.png"
                visible="false"
            />
            <Rectangle
                id="unwatchedPill"
                width="34"
                height="26"
                translation="[118, 16]"
                color="0xE5A00D"
                visible="false"
            />
            <Label
                id="unwatchedLabel"
                width="34"
                height="26"
                translation="[118, 16]"
                horizAlign="center"
                vertAlign="center"
                color="0x14140C"
                visible="false"
            >
                <Font role="font" uri="pkg:/fonts/Outfit-SemiBold.ttf" size="18" />
            </Label>

            <Rectangle
                id="titleBar"
                width="152"
                height="56"
                translation="[8, 180]"
                color="0x000000"
                opacity="0.72"
                visible="false"
            />
            <Label
                id="titleLabel"
                width="144"
                height="48"
                translation="[12, 184]"
                horizAlign="left"
                vertAlign="center"
                wrap="false"
                maxLines="2"
                color="0xFFFFFF"
                visible="false"
            >
                <Font role="font" uri="pkg:/fonts/Outfit-Medium.ttf" size="18" />
            </Label>

            <!-- One visibility toggle so all four sides appear together -->        </Group>
    </children>
</component>
