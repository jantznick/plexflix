<?xml version="1.0" encoding="utf-8" ?>
<component name="PosterItem" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="onContentChange" />
        <field id="focusPercent" type="float" onChange="onFocusPercentChange" />
        <field id="width" type="float" onChange="onSizeChange" />
        <field id="height" type="float" onChange="onSizeChange" />
    </interface>

    <script type="text/brightscript" uri="PosterItem.brs" />

    <children>
        <Rectangle
            id="shadow"
            width="184"
            height="264"
            translation="[10, 12]"
            color="0x000000"
            opacity="0.4"
        />
        <Rectangle
            id="cardBg"
            width="168"
            height="252"
            color="0x16161E"
        />
        <Poster
            id="poster"
            width="168"
            height="252"
            loadDisplayMode="scaleToZoom"
            failedBitmapUri="pkg:/images/poster_placeholder.png"
            loadingBitmapUri="pkg:/images/poster_placeholder.png"
            uri="pkg:/images/poster_placeholder.png"
            opacity="0.78"
        />

        <!-- Soft glow plate behind the ring -->
        <Rectangle
            id="focusGlow"
            width="184"
            height="268"
            translation="[-8, -8]"
            color="0xFFFFFF"
            opacity="0.18"
            visible="false"
        />
        <Poster
            id="focusRing"
            width="184"
            height="268"
            translation="[-8, -8]"
            loadDisplayMode="scaleToFill"
            uri="pkg:/images/focus_ring.png"
            visible="false"
        />
        <Rectangle
            id="focusAccent"
            width="184"
            height="5"
            translation="[-8, 252]"
            color="0xE50914"
            visible="false"
        />

        <Rectangle
            id="progressBg"
            width="168"
            height="5"
            translation="[0, 247]"
            color="0x404040"
            visible="false"
        />
        <Rectangle
            id="progressFg"
            width="0"
            height="5"
            translation="[0, 247]"
            color="0xE50914"
            visible="false"
        />
    </children>
</component>
