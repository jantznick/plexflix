<?xml version="1.0" encoding="utf-8" ?>
<component name="CastDetailScreen" extends="Group">
    <interface>
        <field id="config" type="assocarray" />
        <field id="content" type="assocarray" onChange="onContentSet" />
        <field id="openDetails" type="assocarray" />
        <field id="closed" type="boolean" alwaysNotify="true" />
        <field id="close" type="boolean" alwaysNotify="true" onChange="onCloseRequested" />
    </interface>

    <script type="text/brightscript" uri="CastDetailScreen.brs" />
    <script type="text/brightscript" uri="pkg:/source/Fonts.brs" />
    <script type="text/brightscript" uri="pkg:/source/Spinner.brs" />

    <children>
        <Rectangle width="1920" height="1080" color="0x07070B" />

        <Poster id="backdrop" width="1920" height="720" loadDisplayMode="scaleToZoom" opacity="0.28" />
        <Rectangle width="1920" height="720" color="0x07070B" opacity="0.4" />
        <Rectangle width="1920" height="400" translation="[0, 320]" color="0x07070B" opacity="0.88" />

        <Group translation="[96, 72]">
            <Rectangle width="228" height="342" translation="[8, 10]" color="0x000000" opacity="0.5" />
            <Poster id="poster" width="220" height="330" loadDisplayMode="scaleToZoom" uri="pkg:/images/poster_placeholder.png" />

            <Label id="titleLabel" translation="[268, 12]" width="1400" height="70" color="0xFFFFFF" wrap="true" maxLines="2">
                <Font role="font" uri="pkg:/fonts/Outfit-Bold.ttf" size="50" />
            </Label>
            <Label id="roleLabel" translation="[268, 90]" width="1400" height="36" color="0xA8A8B0">
                <Font role="font" uri="pkg:/fonts/Outfit-Medium.ttf" size="22" />
            </Label>
            <Label id="bioLabel" translation="[268, 136]" width="1380" height="120" color="0xD0D0D6" wrap="true" maxLines="4" lineSpacing="5">
                <Font role="font" uri="pkg:/fonts/Outfit-Regular.ttf" size="22" />
            </Label>

            <Group id="backBtn" translation="[268, 270]">
                <Rectangle id="backBg" width="160" height="52" color="0x2A2A32" />
                <Label id="backLabel" width="160" height="52" horizAlign="center" vertAlign="center" text="← Back" color="0xFFFFFF">
                    <Font role="font" uri="pkg:/fonts/Outfit-Medium.ttf" size="24" />
                </Label>
            </Group>
            <BusySpinner id="spinner" translation="[460, 280]" uri="pkg:/images/spinner.png" visible="false" />

            <ShelfRowList
                id="creditRows"
                translation="[0, 360]"
                itemComponentName="PosterItem"
                numRows="2"
                rowItemSize="[[150, 225]]"
                rowItemSpacing="[[22, 0]]"
                itemSize="[1728, 290]"
                itemSpacing="[0, 24]"
                showRowLabel="[true]"
                rowLabelOffset="[[0, 8]]"
                rowFocusAnimationStyle="fixedFocus"
                vertFocusAnimationStyle="floatingFocus"
                focusXOffset="[0]"
                drawFocusFeedback="true"
                drawFocusFeedbackOnTop="true"
                focusBitmapUri="pkg:/images/focus_ring.9.png"
                focusFootprintBlendColor="0x00000000"
            />
        </Group>
    </children>
</component>
