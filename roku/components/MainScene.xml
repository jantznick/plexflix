<?xml version="1.0" encoding="utf-8" ?>
<component name="MainScene" extends="Scene">
    <script type="text/brightscript" uri="MainScene.brs" />
    <script type="text/brightscript" uri="pkg:/source/PlexConfig.brs" />

    <children>
        <Rectangle
            id="background"
            width="1920"
            height="1080"
            color="0x08080A"
        />

        <Group id="contentHost" translation="[0, 0]">
            <Group id="screens" />
        </Group>

        <SideNav id="sideNav" />

        <Rectangle
            id="navScrim"
            width="1920"
            height="1080"
            color="0x000000"
            opacity="0.45"
            visible="false"
        />

        <Group id="loadingBanner" translation="[64, 1000]" visible="false">
            <Rectangle width="1792" height="72" color="0x121218" opacity="0.92" />
            <Poster
                id="loadingLogo"
                width="160"
                height="44"
                translation="[32, 14]"
                uri="pkg:/images/loading-logo.png"
            />
            <Label
                id="statusLabel"
                translation="[200, 18]"
                width="1500"
                height="36"
                color="0xDDDDDD"
                font="font:SmallSystemFont"
                text=""
            />
        </Group>
    </children>
</component>
