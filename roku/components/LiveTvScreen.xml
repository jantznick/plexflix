<?xml version="1.0" encoding="utf-8" ?>
<component name="LiveTvScreen" extends="Group">
    <interface>
        <field id="config" type="assocarray" onChange="onConfigReady" />
        <field id="selectedItem" type="assocarray" />
        <field id="loadingMessage" type="string" />
        <field id="openMenu" type="boolean" alwaysNotify="true" />
        <field id="refocus" type="boolean" alwaysNotify="true" onChange="onRefocus" />
    </interface>

    <script type="text/brightscript" uri="LiveTvScreen.brs" />
    <script type="text/brightscript" uri="pkg:/source/Fonts.brs" />

    <children>
        <Rectangle width="1920" height="1080" color="0x0A0E18" />

        <Rectangle width="1920" height="56" color="0x121A2A" />
        <Label translation="[96, 12]" width="400" height="36" text="LIVE TV GUIDE" color="0xE50914">
            <Font role="font" uri="pkg:/fonts/Outfit-Bold.ttf" size="24" />
        </Label>
        <Label id="clockLabel" translation="[1400, 14]" width="420" height="32" horizAlign="right" text="" color="0xA8B0C0">
            <Font role="font" uri="pkg:/fonts/Outfit-Medium.ttf" size="18" />
        </Label>

        <Group translation="[96, 72]">
            <Label id="programTitle" width="900" height="52" color="0xFFFFFF" wrap="true" maxLines="2" text="Select a channel">
                <Font role="font" uri="pkg:/fonts/Outfit-Bold.ttf" size="34" />
            </Label>
            <Label id="channelMeta" translation="[0, 56]" width="900" height="28" color="0x8FA0B8" text="">
                <Font role="font" uri="pkg:/fonts/Outfit-Medium.ttf" size="18" />
            </Label>
            <Label id="programSummary" translation="[0, 90]" width="900" height="80" color="0xC5CCD8" wrap="true" maxLines="3" lineSpacing="3" text="">
                <Font role="font" uri="pkg:/fonts/Outfit-Regular.ttf" size="18" />
            </Label>
            <Label id="statusLabel" translation="[0, 190]" width="900" height="32" text="" color="0x778099">
                <Font role="font" uri="pkg:/fonts/Outfit-Regular.ttf" size="16" />
            </Label>

            <!-- True 16:9 preview — matches program art, no ultra-wide letterbox -->
            <Rectangle translation="[1184, 0]" width="640" height="360" color="0x111820" />
            <Poster
                id="previewArt"
                translation="[1184, 0]"
                width="640"
                height="360"
                loadDisplayMode="scaleToZoom"
                loadWidth="1280"
                loadHeight="720"
                uri="pkg:/images/poster_placeholder.png"
                opacity="0.35"
            />
            <Video id="previewVideo" translation="[1184, 0]" width="640" height="360" visible="false" />
            <Label id="previewHint" translation="[1184, 164]" width="640" height="32" horizAlign="center" text="PREVIEW" color="0x556070">
                <Font role="font" uri="pkg:/fonts/Outfit-Medium.ttf" size="18" />
            </Label>
        </Group>

        <Rectangle translation="[0, 450]" width="1920" height="36" color="0x1A2438" />
        <Label translation="[120, 456]" width="280" height="28" text="CHANNEL" color="0x8FA0B8">
            <Font role="font" uri="pkg:/fonts/Outfit-SemiBold.ttf" size="14" />
        </Label>
        <Label translation="[392, 456]" width="560" height="28" text="ON NOW" color="0xE8EEF8">
            <Font role="font" uri="pkg:/fonts/Outfit-SemiBold.ttf" size="14" />
        </Label>
        <Label translation="[972, 456]" width="220" height="28" text="TIME" color="0x8FA0B8">
            <Font role="font" uri="pkg:/fonts/Outfit-SemiBold.ttf" size="14" />
        </Label>
        <Label translation="[1212, 456]" width="560" height="28" text="UP NEXT" color="0x8FA0B8">
            <Font role="font" uri="pkg:/fonts/Outfit-SemiBold.ttf" size="14" />
        </Label>

        <EscapeMarkupList
            id="guideList"
            translation="[72, 492]"
            itemComponentName="GuideRowItem"
            itemSize="[1776, 40]"
            itemSpacing="[0, 2]"
            numRows="12"
            drawFocusFeedback="false"
        />
    </children>
</component>
