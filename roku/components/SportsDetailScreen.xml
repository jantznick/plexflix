<?xml version="1.0" encoding="utf-8" ?>
<component name="SportsDetailScreen" extends="Group">
    <interface>
        <field id="content" type="assocarray" onChange="onContentSet" />
        <field id="playRequested" type="assocarray" />
        <field id="closed" type="boolean" alwaysNotify="true" />
        <field id="close" type="boolean" alwaysNotify="true" onChange="onCloseRequested" />
        <!-- Set after the player closes: focusing the screen Group alone leaves
             the stream list without focus, so no row is lit and OK does nothing -->
        <field id="refocus" type="boolean" alwaysNotify="true" onChange="onRefocus" />
        <field id="streamError" type="string" alwaysNotify="true" onChange="onStreamError" />
    </interface>

    <script type="text/brightscript" uri="SportsDetailScreen.brs" />
    <script type="text/brightscript" uri="pkg:/source/Fonts.brs" />

    <children>
        <Rectangle width="1920" height="1080" color="0x07070B" />

        <Poster id="backdrop" width="1920" height="720" loadDisplayMode="scaleToZoom" opacity="0.22" uri="" />
        <Rectangle width="1920" height="720" color="0x07070B" opacity="0.5" />
        <Rectangle width="1920" height="420" translation="[0, 300]" color="0x07070B" opacity="0.92" />

        <Group translation="[96, 64]">
            <Rectangle width="428" height="244" translation="[6, 8]" color="0x000000" opacity="0.45" />
            <Poster
                id="thumb"
                width="420"
                height="236"
                loadDisplayMode="scaleToZoom"
                uri="pkg:/images/poster_placeholder.png"
            />

            <Label id="titleLabel" translation="[460, 8]" width="1180" height="72" color="0xFFFFFF" wrap="true" maxLines="2">
                <Font role="font" uri="pkg:/fonts/Outfit-Bold.ttf" size="44" />
            </Label>
            <Label id="metaLabel" translation="[460, 88]" width="1180" height="40" color="0xA8A8B0">
                <Font role="font" uri="pkg:/fonts/Outfit-Medium.ttf" size="30" />
            </Label>
            <Label id="summaryLabel" translation="[460, 134]" width="1160" height="76" color="0xC8C8D0" wrap="true" maxLines="2">
                <Font role="font" uri="pkg:/fonts/Outfit-Regular.ttf" size="28" />
            </Label>
            <Label id="streamCountLabel" translation="[460, 216]" width="600" height="36" color="0x777780" text="">
                <Font role="font" uri="pkg:/fonts/Outfit-Regular.ttf" size="26" />
            </Label>

            <Label translation="[0, 296]" width="600" height="48" text="Available streams" color="0xFFFFFF">
                <Font role="font" uri="pkg:/fonts/Outfit-SemiBold.ttf" size="36" />
            </Label>

            <EscapeMarkupList
                id="streamList"
                translation="[0, 360]"
                itemComponentName="GuideRowItem"
                itemSize="[1728, 84]"
                itemSpacing="[0, 6]"
                numRows="7"
                vertFocusAnimationStyle="floatingFocus"
                drawFocusFeedback="false"
            />
        </Group>
    </children>
</component>
