<?xml version="1.0" encoding="utf-8" ?>
<component name="SportsDetailScreen" extends="Group">
    <interface>
        <field id="content" type="assocarray" onChange="onContentSet" />
        <field id="playRequested" type="assocarray" />
        <field id="closed" type="boolean" alwaysNotify="true" />
        <field id="close" type="boolean" alwaysNotify="true" onChange="onCloseRequested" />
    </interface>

    <script type="text/brightscript" uri="SportsDetailScreen.brs" />
    <script type="text/brightscript" uri="pkg:/source/Fonts.brs" />

    <children>
        <Rectangle width="1920" height="1080" color="0x07070B" />

        <Poster id="backdrop" width="1920" height="720" loadDisplayMode="scaleToZoom" opacity="0.22" uri="" />
        <Rectangle width="1920" height="720" color="0x07070B" opacity="0.5" />
        <Rectangle width="1920" height="420" translation="[0, 300]" color="0x07070B" opacity="0.92" />

        <Group translation="[96, 64]">
            <Rectangle width="428" height="244" translation="[6, 8]" color="0x000000" opacity="0.45" />
            <Poster
                id="thumb"
                width="420"
                height="236"
                loadDisplayMode="scaleToZoom"
                uri="pkg:/images/poster_placeholder.png"
            />

            <Label id="titleLabel" translation="[460, 8]" width="1180" height="72" color="0xFFFFFF" wrap="true" maxLines="2">
                <Font role="font" uri="pkg:/fonts/Outfit-Bold.ttf" size="44" />
            </Label>
            <Label id="metaLabel" translation="[460, 88]" width="1180" height="36" color="0xA8A8B0">
                <Font role="font" uri="pkg:/fonts/Outfit-Medium.ttf" size="22" />
            </Label>
            <Label id="summaryLabel" translation="[460, 132]" width="1160" height="70" color="0xC8C8D0" wrap="true" maxLines="2">
                <Font role="font" uri="pkg:/fonts/Outfit-Regular.ttf" size="22" />
            </Label>

            <Group id="backBtn" translation="[460, 220]">
                <Rectangle id="backBg" width="160" height="52" color="0x2A2A32" />
                <Label id="backLabel" width="160" height="52" horizAlign="center" vertAlign="center" text="← Back" color="0xFFFFFF">
                    <Font role="font" uri="pkg:/fonts/Outfit-Medium.ttf" size="24" />
                </Label>
            </Group>
            <Group id="playBtn" translation="[640, 220]">
                <Rectangle id="playBg" width="220" height="52" color="0xE50914" />
                <Label id="playLabel" width="220" height="52" horizAlign="center" vertAlign="center" text="Watch" color="0xFFFFFF">
                    <Font role="font" uri="pkg:/fonts/Outfit-SemiBold.ttf" size="24" />
                </Label>
            </Group>
            <Label id="streamCountLabel" translation="[880, 232]" width="400" height="36" color="0x777780" text="">
                <Font role="font" uri="pkg:/fonts/Outfit-Regular.ttf" size="20" />
            </Label>

            <Label translation="[0, 320]" width="600" height="40" text="Available streams" color="0xFFFFFF">
                <Font role="font" uri="pkg:/fonts/Outfit-SemiBold.ttf" size="28" />
            </Label>

            <EscapeMarkupList
                id="streamList"
                translation="[0, 372]"
                itemComponentName="GuideRowItem"
                itemSize="[1728, 52]"
                itemSpacing="[0, 8]"
                numRows="10"
                drawFocusFeedback="false"
            />
        </Group>
    </children>
</component>
