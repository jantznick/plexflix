<?xml version="1.0" encoding="utf-8" ?>
<component name="HomeScreen" extends="Group">
    <interface>
        <field id="config" type="assocarray" />
        <field id="selectedItem" type="assocarray" />
        <field id="loadingMessage" type="string" />
        <field id="openMenu" type="boolean" alwaysNotify="true" />
        <field id="refocus" type="boolean" alwaysNotify="true" onChange="onRefocus" />
    </interface>

    <script type="text/brightscript" uri="HomeScreen.brs" />
    <script type="text/brightscript" uri="pkg:/source/Fonts.brs" />

    <children>
        <Rectangle width="1920" height="1080" color="0x07070B" />

        <!-- Full-bleed loading state (no splash poster wash) -->
        <Group id="loadingPanel" translation="[0, 0]" visible="true">
            <Rectangle width="1920" height="1080" color="0x07070B" />
            <Label translation="[0, 420]" width="1920" height="60" horizAlign="center" text="PLEXFLIX" color="0xE50914">
                <Font role="font" uri="pkg:/fonts/Outfit-Bold.ttf" size="52" />
            </Label>
            <BusySpinner
                id="loadSpinner"
                translation="[912, 510]"
                uri="pkg:/images/spinner.png"
            />
            <ShimmerRow id="shimmer" translation="[96, 700]" />
        </Group>

        <Group id="frame" translation="[0, 0]" visible="false">
            <Group id="billboard" translation="[0, 0]">
                <Poster
                    id="heroArt"
                    width="1920"
                    height="780"
                    loadDisplayMode="scaleToZoom"
                    uri=""
                />
                <!-- Soft left/bottom readability only — no solid box -->
                <Rectangle width="1920" height="780" color="0x07070B" opacity="0.18" />
                <Rectangle width="1100" height="780" color="0x07070B" opacity="0.45" />
                <Rectangle width="1920" height="320" translation="[0, 460]" color="0x07070B" opacity="0.75" />

                <Group id="heroCopy" translation="[96, 360]">
                    <Label id="heroTitle" width="1000" height="110" text="" color="0xFFFFFF" wrap="true" maxLines="2" lineSpacing="2">
                        <Font role="font" uri="pkg:/fonts/Outfit-Bold.ttf" size="58" />
                    </Label>
                    <Label id="heroMeta" translation="[0, 118]" width="900" height="32" text="" color="0xB8B8C0">
                        <Font role="font" uri="pkg:/fonts/Outfit-Medium.ttf" size="22" />
                    </Label>
                    <Label id="heroSummary" translation="[0, 158]" width="880" height="80" text="" color="0xD0D0D6" wrap="true" maxLines="2" lineSpacing="5">
                        <Font role="font" uri="pkg:/fonts/Outfit-Regular.ttf" size="22" />
                    </Label>
                </Group>
            </Group>

            <Label id="buildLabel" translation="[1520, 36]" width="340" height="36" horizAlign="right" text="v0.3.8" color="0x55555A">
                <Font role="font" uri="pkg:/fonts/Outfit-Medium.ttf" size="16" />
            </Label>

            <ShelfRowList
                id="rowList"
                translation="[96, 620]"
                itemComponentName="PosterItem"
                numRows="3"
                rowItemSize="[[168, 252]]"
                rowItemSpacing="[[28, 0]]"
                itemSize="[1728, 320]"
                itemSpacing="[0, 32]"
                showRowLabel="[true]"
                rowLabelOffset="[[0, 8]]"
                rowFocusAnimationStyle="fixedFocus"
                focusXOffset="[0]"
                drawFocusFeedback="false"
            />

            <Animation
                id="homeAnim"
                duration="0.22"
                easeFunction="outCubic"
                optional="true"
                repeat="false"
            >
                <Vector2DFieldInterpolator
                    id="billboardMove"
                    key="[0.0, 1.0]"
                    keyValue="[[0, 0], [0, 0]]"
                    fieldToInterp="billboard.translation"
                />
                <FloatFieldInterpolator
                    id="billboardFade"
                    key="[0.0, 1.0]"
                    keyValue="[1.0, 1.0]"
                    fieldToInterp="billboard.opacity"
                />
                <Vector2DFieldInterpolator
                    id="rowsMove"
                    key="[0.0, 1.0]"
                    keyValue="[[96, 620], [96, 620]]"
                    fieldToInterp="rowList.translation"
                />
            </Animation>
        </Group>
    </children>
</component>
