<?xml version="1.0" encoding="utf-8" ?>
<component name="HomeScreen" extends="Group">
    <interface>
        <field id="config" type="assocarray" />
        <field id="selectedItem" type="assocarray" />
        <field id="loadingMessage" type="string" />
        <field id="openMenu" type="boolean" alwaysNotify="true" />
        <field id="refocus" type="boolean" alwaysNotify="true" onChange="onRefocus" />
    </interface>

    <script type="text/brightscript" uri="HomeScreen.brs" />
    <script type="text/brightscript" uri="pkg:/source/Fonts.brs" />

    <children>
        <Rectangle width="1920" height="1080" color="0x07070B" />

        <Group id="loadingPanel" translation="[0, 0]" visible="true">
            <Rectangle width="1920" height="1080" color="0x07070B" />
            <Label translation="[0, 420]" width="1920" height="60" horizAlign="center" text="PLEXFLIX" color="0xE50914">
                <Font role="font" uri="pkg:/fonts/Outfit-Bold.ttf" size="52" />
            </Label>
            <BusySpinner id="loadSpinner" translation="[912, 510]" uri="pkg:/images/spinner.png" />
            <ShimmerRow id="shimmer" translation="[96, 700]" />
        </Group>

        <!-- Clip the whole home frame so shelves hard-cut at screen edges -->
        <Group id="frame" translation="[0, 0]" visible="false" clippingRect="[0, 0, 1920, 1080]">
            <Group id="billboard" translation="[0, 0]" clippingRect="[0, 0, 1920, 480]">
                <Rectangle width="1920" height="480" color="0x0A0A10" />
                <Poster
                    id="heroArt"
                    width="1920"
                    height="480"
                    loadDisplayMode="scaleToZoom"
                    uri=""
                />
                <!-- Tiny bottom fade only — title sits on it, no fat midline band -->
                <Rectangle width="1920" height="140" translation="[0, 340]" color="0x07070B" opacity="0.5" />

                <Group id="heroCopy" translation="[96, 300]">
                    <Label id="heroTitle" width="1200" height="70" text="" color="0xFFFFFF" wrap="true" maxLines="2" lineSpacing="1">
                        <Font role="font" uri="pkg:/fonts/Outfit-Bold.ttf" size="40" />
                    </Label>
                    <Label id="heroMeta" translation="[0, 68]" width="1100" height="26" text="" color="0xB8B8C0">
                        <Font role="font" uri="pkg:/fonts/Outfit-Medium.ttf" size="17" />
                    </Label>
                    <Label id="heroSummary" translation="[0, 96]" width="1000" height="50" text="" color="0xD0D0D6" wrap="true" maxLines="2" lineSpacing="2">
                        <Font role="font" uri="pkg:/fonts/Outfit-Regular.ttf" size="17" />
                    </Label>
                </Group>
            </Group>

            <!--
              Row geometry is intentional:
              expanded Y=500, rowH=300 → only ~1.9 shelves fit → bottom shelf is cut off.
              collapsed Y=-80 with fixedFocus → previous shelf peeks clipped above; active sits fully on-screen.
            -->
            <ShelfRowList
                id="rowList"
                translation="[96, 500]"
                itemComponentName="PosterItem"
                numRows="4"
                rowItemSize="[[150, 225]]"
                rowItemSpacing="[[22, 0]]"
                itemSize="[1728, 300]"
                itemSpacing="[0, 10]"
                showRowLabel="[true]"
                rowLabelOffset="[[0, 4]]"
                rowFocusAnimationStyle="fixedFocus"
                focusXOffset="[0]"
                drawFocusFeedback="false"
            />

            <Animation id="homeAnim" duration="0.18" easeFunction="outCubic" optional="true" repeat="false">
                <Vector2DFieldInterpolator id="billboardMove" key="[0.0, 1.0]" keyValue="[[0, 0], [0, 0]]" fieldToInterp="billboard.translation" />
                <FloatFieldInterpolator id="billboardFade" key="[0.0, 1.0]" keyValue="[1.0, 1.0]" fieldToInterp="billboard.opacity" />
                <Vector2DFieldInterpolator id="rowsMove" key="[0.0, 1.0]" keyValue="[[96, 500], [96, 500]]" fieldToInterp="rowList.translation" />
            </Animation>
        </Group>
    </children>
</component>
