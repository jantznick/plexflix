<?xml version="1.0" encoding="utf-8" ?>
<component name="HomeScreen" extends="Group">
    <interface>
        <field id="config" type="assocarray" />
        <field id="selectedItem" type="assocarray" />
        <field id="loadingMessage" type="string" />
        <field id="openMenu" type="boolean" alwaysNotify="true" />
        <field id="refocus" type="boolean" alwaysNotify="true" onChange="onRefocus" />
    </interface>

    <script type="text/brightscript" uri="HomeScreen.brs" />
    <script type="text/brightscript" uri="pkg:/source/Fonts.brs" />

    <children>
        <Rectangle width="1920" height="1080" color="0x07070B" />

        <Group id="loadingPanel" translation="[0, 0]" visible="true">
            <Rectangle width="1920" height="1080" color="0x07070B" />
            <Label translation="[0, 420]" width="1920" height="60" horizAlign="center" text="PLEXFLIX" color="0xE50914">
                <Font role="font" uri="pkg:/fonts/Outfit-Bold.ttf" size="52" />
            </Label>
            <BusySpinner id="loadSpinner" translation="[912, 510]" uri="pkg:/images/spinner.png" />
            <ShimmerRow id="shimmer" translation="[96, 700]" />
        </Group>

        <Group id="frame" translation="[0, 0]" visible="false">
            <!-- Full-res art clipped to billboard height — avoids forced stretch -->
            <Group id="billboard" translation="[0, 0]" clippingRect="[0, 0, 1920, 540]">
                <Poster
                    id="heroArt"
                    width="1920"
                    height="1080"
                    translation="[0, -180]"
                    loadDisplayMode="scaleToZoom"
                    uri=""
                />
                <!-- One soft bottom scrim for title readability -->
                <Rectangle width="1920" height="220" translation="[0, 320]" color="0x07070B" opacity="0.55" />

                <Group id="heroCopy" translation="[96, 340]">
                    <Label id="heroTitle" width="1200" height="80" text="" color="0xFFFFFF" wrap="true" maxLines="2" lineSpacing="2">
                        <Font role="font" uri="pkg:/fonts/Outfit-Bold.ttf" size="44" />
                    </Label>
                    <Label id="heroMeta" translation="[0, 78]" width="1100" height="28" text="" color="0xB8B8C0">
                        <Font role="font" uri="pkg:/fonts/Outfit-Medium.ttf" size="18" />
                    </Label>
                    <Label id="heroSummary" translation="[0, 108]" width="1000" height="56" text="" color="0xD0D0D6" wrap="true" maxLines="2" lineSpacing="3">
                        <Font role="font" uri="pkg:/fonts/Outfit-Regular.ttf" size="18" />
                    </Label>
                </Group>
            </Group>

            <Label id="buildLabel" translation="[1520, 36]" width="340" height="36" horizAlign="right" text="v0.4.6" color="0x55555A">
                <Font role="font" uri="pkg:/fonts/Outfit-Medium.ttf" size="16" />
            </Label>

            <!-- First shelf fully below hero. fixedFocus: focused shelf stays in the visible slot. -->
            <ShelfRowList
                id="rowList"
                translation="[96, 560]"
                itemComponentName="PosterItem"
                numRows="3"
                rowItemSize="[[150, 225]]"
                rowItemSpacing="[[22, 0]]"
                itemSize="[1728, 280]"
                itemSpacing="[0, 16]"
                showRowLabel="[true]"
                rowLabelOffset="[[0, 6]]"
                rowFocusAnimationStyle="fixedFocus"
                focusXOffset="[0]"
                drawFocusFeedback="false"
            />

            <Animation id="homeAnim" duration="0.18" easeFunction="outCubic" optional="true" repeat="false">
                <Vector2DFieldInterpolator id="billboardMove" key="[0.0, 1.0]" keyValue="[[0, 0], [0, 0]]" fieldToInterp="billboard.translation" />
                <FloatFieldInterpolator id="billboardFade" key="[0.0, 1.0]" keyValue="[1.0, 1.0]" fieldToInterp="billboard.opacity" />
                <Vector2DFieldInterpolator id="rowsMove" key="[0.0, 1.0]" keyValue="[[96, 560], [96, 560]]" fieldToInterp="rowList.translation" />
            </Animation>
        </Group>
    </children>
</component>
