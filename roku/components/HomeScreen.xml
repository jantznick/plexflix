<?xml version="1.0" encoding="utf-8" ?>
<component name="HomeScreen" extends="Group">
    <interface>
        <field id="config" type="assocarray" />
        <field id="selectedItem" type="assocarray" />
        <field id="loadingMessage" type="string" />
    </interface>

    <script type="text/brightscript" uri="HomeScreen.brs" />

    <children>
        ' Full-bleed billboard — rows sit over the lower half (Netflix-style)
        <Poster
            id="heroArt"
            width="1920"
            height="820"
            loadDisplayMode="scaleToFill"
            uri="pkg:/images/splash-screen_fhd.jpg"
        />

        ' Soft scrims instead of a hard black bar
        <Rectangle
            id="heroDim"
            width="1920"
            height="820"
            color="0x000000"
            opacity="0.25"
        />
        <Rectangle
            width="980"
            height="820"
            color="0x000000"
            opacity="0.45"
        />
        <Rectangle
            id="heroFade"
            width="1920"
            height="360"
            translation="[0, 460]"
            color="0x0A0A0A"
            opacity="0.92"
        />
        <Rectangle
            width="1920"
            height="280"
            translation="[0, 800]"
            color="0x0A0A0A"
        />

        <Label
            id="brandLabel"
            translation="[72, 28]"
            width="500"
            height="48"
            text="PLEXFLIX"
            color="0xE50914"
            font="font:MediumBoldSystemFont"
        />

        <Group id="heroCopy" translation="[72, 220]">
            <Label
                id="heroTitle"
                width="900"
                height="96"
                text="Loading your library..."
                color="0xFFFFFF"
                font="font:LargeBoldSystemFont"
                wrap="true"
                maxLines="2"
                lineSpacing="2"
            />
            <Label
                id="heroMeta"
                translation="[0, 104]"
                width="900"
                height="32"
                text=""
                color="0xC7C7C7"
                font="font:SmallSystemFont"
            />
            <Label
                id="heroSummary"
                translation="[0, 144]"
                width="820"
                height="84"
                text=""
                color="0xD0D0D0"
                font="font:SmallSystemFont"
                wrap="true"
                maxLines="2"
                lineSpacing="4"
            />
        </Group>

        ' Start high enough that ~3 shelves fit on FHD
        <RowList
            id="rowList"
            translation="[0, 460]"
            itemComponentName="PosterItem"
            numRows="3"
            rowItemSize="[[154, 231]]"
            rowItemSpacing="[[14, 0]]"
            itemSize="[1920, 290]"
            itemSpacing="[0, 8]"
            showRowLabel="[true]"
            rowLabelOffset="[[72, 4]]"
            rowFocusAnimationStyle="fixedFocus"
            focusXOffset="[72]"
            drawFocusFeedback="true"
            focusBitmapUri="pkg:/images/focus_border.png"
        />
    </children>
</component>
