<?xml version="1.0" encoding="utf-8" ?>
<component name="HomeScreen" extends="Group">
    <interface>
        <field id="config" type="assocarray" />
        <field id="selectedItem" type="assocarray" />
        <field id="loadingMessage" type="string" />
        <field id="openMenu" type="boolean" alwaysNotify="true" />
        <field id="refocus" type="boolean" alwaysNotify="true" onChange="onRefocus" />
    </interface>

    <script type="text/brightscript" uri="HomeScreen.brs" />
    <script type="text/brightscript" uri="pkg:/source/Fonts.brs" />

    <children>
        <Rectangle width="1920" height="1080" color="0x07070B" />

        <Group id="loadingPanel" translation="[0, 0]" visible="true">
            <Rectangle width="1920" height="1080" color="0x07070B" />
            <Label translation="[0, 420]" width="1920" height="60" horizAlign="center" text="PLEXFLIX" color="0xE50914">
                <Font role="font" uri="pkg:/fonts/Outfit-Bold.ttf" size="52" />
            </Label>
            <BusySpinner id="loadSpinner" translation="[912, 510]" uri="pkg:/images/spinner.png" />
            <ShimmerRow id="shimmer" translation="[96, 700]" />
        </Group>

        <Group id="frame" translation="[0, 0]" visible="false">
            <!-- Billboard clipped to its own height so washes never cover shelves -->
            <Group id="billboard" translation="[0, 0]" clippingRect="[0, 0, 1920, 500]">
                <Poster
                    id="heroArt"
                    width="1920"
                    height="500"
                    loadDisplayMode="scaleToZoom"
                    loadWidth="1920"
                    loadHeight="800"
                    uri=""
                />
                <!-- Bottom fade only — no left panel (that caused the vertical seam) -->
                <Rectangle width="1920" height="160" translation="[0, 340]" color="0x07070B" opacity="0.35" />
                <Rectangle width="1920" height="100" translation="[0, 400]" color="0x07070B" opacity="0.55" />
                <Rectangle width="1920" height="50" translation="[0, 450]" color="0x07070B" opacity="0.75" />

                <Group id="heroCopy" translation="[96, 280]">
                    <Label id="heroTitle" width="1100" height="90" text="" color="0xFFFFFF" wrap="true" maxLines="2" lineSpacing="2">
                        <Font role="font" uri="pkg:/fonts/Outfit-Bold.ttf" size="46" />
                    </Label>
                    <Label id="heroMeta" translation="[0, 88]" width="1000" height="28" text="" color="0xB8B8C0">
                        <Font role="font" uri="pkg:/fonts/Outfit-Medium.ttf" size="18" />
                    </Label>
                    <Label id="heroSummary" translation="[0, 120]" width="980" height="60" text="" color="0xD0D0D6" wrap="true" maxLines="2" lineSpacing="3">
                        <Font role="font" uri="pkg:/fonts/Outfit-Regular.ttf" size="18" />
                    </Label>
                </Group>
            </Group>

            <Label id="buildLabel" translation="[1520, 36]" width="340" height="36" horizAlign="right" text="v0.4.5" color="0x55555A">
                <Font role="font" uri="pkg:/fonts/Outfit-Medium.ttf" size="16" />
            </Label>

            <!-- Fully below hero; floatingFocus keeps active shelf on-screen; previous peeks above -->
            <ShelfRowList
                id="rowList"
                translation="[96, 520]"
                itemComponentName="PosterItem"
                numRows="3"
                rowItemSize="[[150, 225]]"
                rowItemSpacing="[[22, 0]]"
                itemSize="[1728, 280]"
                itemSpacing="[0, 14]"
                showRowLabel="[true]"
                rowLabelOffset="[[0, 4]]"
                rowFocusAnimationStyle="floatingFocus"
                focusXOffset="[0]"
                drawFocusFeedback="false"
            />

            <Animation id="homeAnim" duration="0.2" easeFunction="outCubic" optional="true" repeat="false">
                <Vector2DFieldInterpolator id="billboardMove" key="[0.0, 1.0]" keyValue="[[0, 0], [0, 0]]" fieldToInterp="billboard.translation" />
                <FloatFieldInterpolator id="billboardFade" key="[0.0, 1.0]" keyValue="[1.0, 1.0]" fieldToInterp="billboard.opacity" />
                <Vector2DFieldInterpolator id="rowsMove" key="[0.0, 1.0]" keyValue="[[96, 520], [96, 520]]" fieldToInterp="rowList.translation" />
            </Animation>
        </Group>
    </children>
</component>
