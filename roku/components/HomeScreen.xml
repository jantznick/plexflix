<?xml version="1.0" encoding="utf-8" ?>
<component name="HomeScreen" extends="Group">
    <interface>
        <field id="config" type="assocarray" />
        <field id="selectedItem" type="assocarray" />
        <field id="loadingMessage" type="string" />
    </interface>

    <script type="text/brightscript" uri="HomeScreen.brs" />

    <children>
        <Rectangle width="1920" height="1080" color="0x0A0A0A" />

        <Group id="billboard" translation="[0, 0]">
            <Poster
                id="heroArt"
                width="1920"
                height="760"
                loadDisplayMode="scaleToFill"
                uri="pkg:/images/splash-screen_fhd.jpg"
            />
            <Rectangle width="1920" height="760" color="0x000000" opacity="0.18" />
            <Rectangle width="1040" height="760" color="0x000000" opacity="0.42" />
            <Rectangle
                width="1920"
                height="280"
                translation="[0, 480]"
                color="0x0A0A0A"
                opacity="0.95"
            />

            <Group id="heroCopy" translation="[80, 280]">
                <Label
                    id="heroTitle"
                    width="920"
                    height="90"
                    text="Loading your library..."
                    color="0xFFFFFF"
                    font="font:LargeBoldSystemFont"
                    wrap="true"
                    maxLines="2"
                    lineSpacing="2"
                />
                <Label
                    id="heroMeta"
                    translation="[0, 100]"
                    width="900"
                    height="32"
                    text=""
                    color="0xC7C7C7"
                    font="font:SmallSystemFont"
                />
                <Label
                    id="heroSummary"
                    translation="[0, 140]"
                    width="820"
                    height="70"
                    text=""
                    color="0xD0D0D0"
                    font="font:SmallSystemFont"
                    wrap="true"
                    maxLines="2"
                    lineSpacing="4"
                />
            </Group>
        </Group>

        <Label
            id="brandLabel"
            translation="[80, 28]"
            width="500"
            height="44"
            text="PLEXFLIX"
            color="0xE50914"
            font="font:MediumBoldSystemFont"
        />

        <Label
            id="buildLabel"
            translation="[1600, 32]"
            width="250"
            height="36"
            horizAlign="right"
            text="v0.3.1"
            color="0x555555"
            font="font:SmallestSystemFont"
        />

        <RowList
            id="rowList"
            translation="[0, 600]"
            itemComponentName="PosterItem"
            numRows="2"
            rowItemSize="[[180, 270]]"
            rowItemSpacing="[[28, 0]]"
            itemSize="[1920, 340]"
            itemSpacing="[0, 28]"
            showRowLabel="[true]"
            rowLabelOffset="[[80, 8]]"
            rowFocusAnimationStyle="fixedFocus"
            focusXOffset="[80]"
            drawFocusFeedback="false"
        />
    </children>
</component>
