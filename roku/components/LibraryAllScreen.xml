<?xml version="1.0" encoding="utf-8" ?>
<component name="LibraryAllScreen" extends="Group">
    <interface>
        <field id="config" type="assocarray" />
        <field id="source" type="assocarray" onChange="onSourceSet" />
        <field id="selectedItem" type="assocarray" />
        <field id="closed" type="boolean" alwaysNotify="true" />
        <field id="close" type="boolean" alwaysNotify="true" onChange="onCloseRequested" />
        <field id="loadingMessage" type="string" />
        <field id="openMenu" type="boolean" alwaysNotify="true" />
        <field id="refocus" type="boolean" alwaysNotify="true" onChange="onRefocus" />
    </interface>

    <script type="text/brightscript" uri="LibraryAllScreen.brs" />
    <script type="text/brightscript" uri="pkg:/source/Fonts.brs" />

    <children>
        <Rectangle width="1920" height="1080" color="0x07070B" />

        <Group id="header" translation="[72, 24]">
            <Label id="titleLabel" translation="[0, 2]" width="960" height="44" text="Library" color="0xFFFFFF">
                <Font role="font" uri="pkg:/fonts/Outfit-Bold.ttf" size="32" />
            </Label>
            <Label id="metaLabel" translation="[0, 52]" width="960" height="28" text="" color="0x9A9AA4">
                <Font role="font" uri="pkg:/fonts/Outfit-Regular.ttf" size="18" />
            </Label>
            <Label id="posLabel" translation="[986, 52]" width="790" height="28" text="" horizAlign="right" color="0x777780">
                <Font role="font" uri="pkg:/fonts/Outfit-Regular.ttf" size="18" />
            </Label>

            <Group id="filterBtn" translation="[1058, 0]">
                <Rectangle id="filterBg" width="170" height="48" color="0x2A2A32" />
                <Label id="filterLabel" width="170" height="48" horizAlign="center" vertAlign="center" text="Filter" color="0xFFFFFF">
                    <Font role="font" uri="pkg:/fonts/Outfit-Medium.ttf" size="22" />
                </Label>
            </Group>
            <Group id="searchBtn" translation="[1240, 0]">
                <Rectangle id="searchBg" width="170" height="48" color="0x2A2A32" />
                <Label id="searchLabel" width="170" height="48" horizAlign="center" vertAlign="center" text="Search" color="0xFFFFFF">
                    <Font role="font" uri="pkg:/fonts/Outfit-Medium.ttf" size="22" />
                </Label>
            </Group>
            <Group id="sortBtn" translation="[1422, 0]">
                <Rectangle id="sortBg" width="354" height="48" color="0x2A2A32" />
                <Label id="sortLabel" width="334" height="48" translation="[10, 0]" horizAlign="center" vertAlign="center" text="Order by: Title A–Z" color="0xFFFFFF">
                    <Font role="font" uri="pkg:/fonts/Outfit-Medium.ttf" size="22" />
                </Label>
            </Group>
        </Group>

        <!-- 11 x 4 poster grid; content is a sliding window over the Plex pages -->
        <MarkupGrid
            id="grid"
            translation="[72, 118]"
            itemComponentName="PosterItem"
            itemSize="[148, 222]"
            itemSpacing="[14, 16]"
            numColumns="11"
            numRows="4"
            vertFocusAnimationStyle="fixedFocus"
            drawFocusFeedback="false"
        />

        <Label id="emptyLabel" translation="[72, 420]" width="1776" height="120" text="" horizAlign="center" wrap="true" maxLines="3" color="0xC8C8D0" visible="false">
            <Font role="font" uri="pkg:/fonts/Outfit-Medium.ttf" size="28" />
        </Label>

        <BusySpinner id="spinner" translation="[920, 520]" uri="pkg:/images/spinner.png" visible="false" />

        <Group id="filterPanel" visible="false">
            <Rectangle width="1920" height="1080" color="0x000000" opacity="0.72" />
            <Rectangle translation="[560, 110]" width="800" height="800" color="0x14141C" />
            <Rectangle translation="[560, 110]" width="800" height="4" color="0xE50914" />
            <Label id="panelTitle" translation="[600, 142]" width="720" height="46" text="Filter" color="0xFFFFFF">
                <Font role="font" uri="pkg:/fonts/Outfit-Bold.ttf" size="34" />
            </Label>
            <Label id="panelHint" translation="[600, 196]" width="720" height="32" text="" color="0x9A9AA4">
                <Font role="font" uri="pkg:/fonts/Outfit-Regular.ttf" size="20" />
            </Label>
            <LabelList
                id="filterList"
                translation="[600, 244]"
                itemSize="[720, 52]"
                itemSpacing="[0, 4]"
                numRows="10"
                color="0xCCCCCC"
                focusedColor="0x111118"
                drawFocusFeedback="true"
            >
                <Font role="font" uri="pkg:/fonts/Outfit-Regular.ttf" size="24" />
                <Font role="focusedFont" uri="pkg:/fonts/Outfit-SemiBold.ttf" size="24" />
            </LabelList>
            <Label translation="[600, 852]" width="720" height="40" text="OK applies · Back closes" color="0x666670">
                <Font role="font" uri="pkg:/fonts/Outfit-Regular.ttf" size="18" />
            </Label>
        </Group>
    </children>
</component>
