<?xml version="1.0" encoding="utf-8" ?>
<component name="LibraryAllScreen" extends="Group">
    <interface>
        <field id="config" type="assocarray" />
        <field id="source" type="assocarray" onChange="onSourceSet" />
        <field id="selectedItem" type="assocarray" />
        <field id="closed" type="boolean" alwaysNotify="true" />
        <field id="close" type="boolean" alwaysNotify="true" onChange="onCloseRequested" />
        <field id="loadingMessage" type="string" />
        <field id="openMenu" type="boolean" alwaysNotify="true" />
    </interface>

    <script type="text/brightscript" uri="LibraryAllScreen.brs" />
    <script type="text/brightscript" uri="pkg:/source/Fonts.brs" />

    <children>
        <Rectangle width="1920" height="1080" color="0x07070B" />

        <!-- Top bar -->
        <Group translation="[96, 40]">
            <Label id="titleLabel" width="900" height="48" text="Library" color="0xFFFFFF">
                <Font role="font" uri="pkg:/fonts/Outfit-Bold.ttf" size="36" />
            </Label>
            <Label id="metaLabel" translation="[0, 48]" width="1100" height="32" text="" color="0x777780">
                <Font role="font" uri="pkg:/fonts/Outfit-Regular.ttf" size="20" />
            </Label>

            <Group id="filterBtn" translation="[1280, 4]">
                <Rectangle id="filterBg" width="200" height="52" color="0x2A2A32" />
                <Label width="200" height="52" horizAlign="center" vertAlign="center" text="Filter" color="0xFFFFFF">
                    <Font role="font" uri="pkg:/fonts/Outfit-Medium.ttf" size="24" />
                </Label>
            </Group>
            <Group id="searchBtn" translation="[1500, 4]">
                <Rectangle id="searchBg" width="200" height="52" color="0x2A2A32" />
                <Label width="200" height="52" horizAlign="center" vertAlign="center" text="Search" color="0xFFFFFF">
                    <Font role="font" uri="pkg:/fonts/Outfit-Medium.ttf" size="24" />
                </Label>
            </Group>
        </Group>

        <BusySpinner id="spinner" translation="[920, 520]" uri="pkg:/images/spinner.png" visible="false" />

        <MarkupGrid
            id="grid"
            translation="[96, 120]"
            itemComponentName="PosterItem"
            itemSize="[150, 225]"
            itemSpacing="[18, 24]"
            numColumns="10"
            numRows="3"
            drawFocusFeedback="false"
            visible="false"
        />

        <!-- Filter overlay panel -->
        <Group id="filterPanel" visible="false">
            <Rectangle width="1920" height="1080" color="0x000000" opacity="0.65" />
            <Rectangle translation="[480, 120]" width="960" height="780" color="0x16161E" />
            <Label translation="[520, 148]" width="600" height="48" text="Filter &amp; Sort" color="0xFFFFFF">
                <Font role="font" uri="pkg:/fonts/Outfit-Bold.ttf" size="34" />
            </Label>
            <Label translation="[520, 210]" width="400" height="32" text="Options" color="0xA8A8B0">
                <Font role="font" uri="pkg:/fonts/Outfit-Medium.ttf" size="20" />
            </Label>
            <LabelList
                id="filterList"
                translation="[520, 250]"
                itemSize="[880, 52]"
                itemSpacing="[0, 4]"
                numRows="10"
                color="0xCCCCCC"
                focusedColor="0xFFFFFF"
                drawFocusFeedback="true"
            />
            <Label translation="[520, 820]" width="880" height="40" text="OK apply · Back closes" color="0x666670">
                <Font role="font" uri="pkg:/fonts/Outfit-Regular.ttf" size="18" />
            </Label>
        </Group>
    </children>
</component>
