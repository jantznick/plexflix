<?xml version="1.0" encoding="utf-8" ?>
<component name="DetailScreen" extends="Group">
    <interface>
        <field id="config" type="assocarray" />
        <field id="content" type="assocarray" onChange="onContentSet" />
        <field id="playRequested" type="assocarray" />
        <field id="openDetails" type="assocarray" />
        <field id="closed" type="boolean" alwaysNotify="true" />
        <field id="close" type="boolean" alwaysNotify="true" onChange="onCloseRequested" />
    </interface>

    <script type="text/brightscript" uri="DetailScreen.brs" />

    <children>
        <Rectangle width="1920" height="1080" color="0x08080A" />

        <Group id="frame" translation="[64, 48]">
            <Poster
                id="backdrop"
                width="1792"
                height="480"
                loadDisplayMode="scaleToFill"
                opacity="0.32"
            />
            <Rectangle width="1792" height="480" color="0x08080A" opacity="0.55" />
            <Rectangle width="1792" height="720" translation="[0, 300]" color="0x08080A" opacity="0.96" />

            <Poster
                id="poster"
                translation="[0, 0]"
                width="200"
                height="300"
                loadDisplayMode="scaleToZoom"
                uri="pkg:/images/poster_placeholder.png"
            />

            <Label
                id="titleLabel"
                translation="[232, 4]"
                width="1400"
                height="64"
                color="0xFFFFFF"
                font="font:LargeBoldSystemFont"
                wrap="true"
                maxLines="2"
            />
            <Label
                id="metaLabel"
                translation="[232, 76]"
                width="1400"
                height="32"
                color="0xB3B3B3"
                font="font:SmallSystemFont"
            />
            <Label
                id="summaryLabel"
                translation="[232, 116]"
                width="1360"
                height="72"
                color="0xD6D6D6"
                font="font:SmallSystemFont"
                wrap="true"
                maxLines="2"
                lineSpacing="4"
            />

            <Group id="movieActions" translation="[232, 208]" visible="true">
                <Group id="playBtn" translation="[0, 0]">
                    <Rectangle id="playBg" width="220" height="56" color="0xE50914" />
                    <Label
                        id="playLabel"
                        width="220"
                        height="56"
                        horizAlign="center"
                        vertAlign="center"
                        text="Play"
                        color="0xFFFFFF"
                        font="font:MediumBoldSystemFont"
                    />
                </Group>
                <Group id="backBtn" translation="[240, 0]">
                    <Rectangle id="backBg" width="160" height="56" color="0x2A2A2A" />
                    <Label
                        id="backLabel"
                        width="160"
                        height="56"
                        horizAlign="center"
                        vertAlign="center"
                        text="Back"
                        color="0xFFFFFF"
                        font="font:MediumSystemFont"
                    />
                </Group>
            </Group>

            <Label
                id="softStatus"
                translation="[232, 280]"
                width="1200"
                height="28"
                text=""
                color="0x777777"
                font="font:SmallestSystemFont"
            />

            <Group id="tvPanel" translation="[0, 340]" visible="false">
                <RowList
                    id="seasonRows"
                    translation="[0, 0]"
                    itemComponentName="EpisodeItem"
                    numRows="2"
                    rowItemSize="[[300, 170]]"
                    rowItemSpacing="[[22, 0]]"
                    itemSize="[1792, 240]"
                    itemSpacing="[0, 22]"
                    showRowLabel="[true]"
                    rowLabelOffset="[[0, 8]]"
                    rowFocusAnimationStyle="fixedFocus"
                    focusXOffset="[0]"
                    drawFocusFeedback="false"
                />
            </Group>

            <Group id="relatedPanel" translation="[0, 340]" visible="false">
                <RowList
                    id="relatedRows"
                    translation="[0, 0]"
                    itemComponentName="PosterItem"
                    numRows="2"
                    rowItemSize="[[140, 210]]"
                    rowItemSpacing="[[18, 0]]"
                    itemSize="[1792, 270]"
                    itemSpacing="[0, 16]"
                    showRowLabel="[true]"
                    rowLabelOffset="[[0, 8]]"
                    rowFocusAnimationStyle="fixedFocus"
                    focusXOffset="[0]"
                    drawFocusFeedback="false"
                />
            </Group>
        </Group>
    </children>
</component>
