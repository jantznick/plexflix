<?xml version="1.0" encoding="utf-8" ?>
<component name="DetailScreen" extends="Group">
    <interface>
        <field id="config" type="assocarray" />
        <field id="content" type="assocarray" onChange="onContentSet" />
        <field id="playRequested" type="assocarray" />
        <field id="openDetails" type="assocarray" />
        <field id="closed" type="boolean" alwaysNotify="true" />
        <field id="close" type="boolean" alwaysNotify="true" onChange="onCloseRequested" />
    </interface>

    <script type="text/brightscript" uri="DetailScreen.brs" />
    <script type="text/brightscript" uri="pkg:/source/Fonts.brs" />

    <children>
        <Rectangle width="1920" height="1080" color="0x07070B" />

        <!-- Full-bleed hero — taller art plane (rails sit lower) -->
        <Poster
            id="backdrop"
            width="1920"
            height="780"
            loadDisplayMode="scaleToZoom"
            loadWidth="1920"
            loadHeight="1080"
            opacity="1"
        />
        <!-- Soft washes only — no hard vertical panel -->
        <Rectangle width="1920" height="780" color="0x07070B" opacity="0.14" />
        <Rectangle width="1920" height="260" translation="[0, 520]" color="0x07070B" opacity="0.55" />
        <Rectangle width="1920" height="180" translation="[0, 640]" color="0x07070B" opacity="0.82" />

        <Group id="frame" translation="[96, 56]">
            <Rectangle width="232" height="348" translation="[8, 10]" color="0x000000" opacity="0.55" />
            <Poster
                id="poster"
                translation="[0, 0]"
                width="224"
                height="336"
                loadDisplayMode="scaleToZoom"
                uri="pkg:/images/poster_placeholder.png"
            />

            <Label id="titleLabel" translation="[264, 12]" width="1430" height="70" color="0xFFFFFF" wrap="true" maxLines="2">
                <Font role="font" uri="pkg:/fonts/Outfit-Bold.ttf" size="52" />
            </Label>
            <Label id="metaLabel" translation="[264, 92]" width="1430" height="32" color="0xA8A8B0">
                <Font role="font" uri="pkg:/fonts/Outfit-Medium.ttf" size="22" />
            </Label>
            <Label id="summaryLabel" translation="[264, 136]" width="1380" height="80" color="0xD0D0D6" wrap="true" maxLines="2" lineSpacing="5">
                <Font role="font" uri="pkg:/fonts/Outfit-Regular.ttf" size="22" />
            </Label>

            <Group id="movieActions" translation="[264, 240]" visible="true">
                <Group id="playBtn" translation="[0, 0]">
                    <Rectangle id="playShadow" width="228" height="60" translation="[4, 5]" color="0x000000" opacity="0.45" />
                    <Rectangle id="playBg" width="220" height="56" color="0xE50914" />
                    <Label id="playLabel" width="220" height="56" horizAlign="center" vertAlign="center" text="Play" color="0xFFFFFF">
                        <Font role="font" uri="pkg:/fonts/Outfit-SemiBold.ttf" size="26" />
                    </Label>
                </Group>
                <Group id="backBtn" translation="[248, 0]">
                    <Rectangle id="backShadow" width="168" height="60" translation="[4, 5]" color="0x000000" opacity="0.0" />
                    <Rectangle id="backBg" width="160" height="56" color="0x2A2A32" />
                    <Label id="backLabel" width="160" height="56" horizAlign="center" vertAlign="center" text="Back" color="0xFFFFFF">
                        <Font role="font" uri="pkg:/fonts/Outfit-Medium.ttf" size="24" />
                    </Label>
                </Group>
            </Group>

            <Label id="softStatus" translation="[264, 316]" width="1200" height="28" text="" color="0x666670">
                <Font role="font" uri="pkg:/fonts/Outfit-Regular.ttf" size="18" />
            </Label>

            <!-- Rails sit lower so more hero art stays visible -->
            <Group id="tvPanel" translation="[0, 470]" visible="false">
                <ShelfRowList
                    id="seasonRows"
                    translation="[0, 0]"
                    itemComponentName="EpisodeItem"
                    numRows="2"
                    rowItemSize="[[300, 170]]"
                    rowItemSpacing="[[24, 0]]"
                    itemSize="[1728, 250]"
                    itemSpacing="[0, 20]"
                    showRowLabel="[true]"
                    rowLabelOffset="[[0, 8]]"
                    rowFocusAnimationStyle="fixedFocus"
                    focusXOffset="[0]"
                    drawFocusFeedback="false"
                />
            </Group>

            <Group id="relatedPanel" translation="[0, 470]" visible="false">
                <ShelfRowList
                    id="relatedRows"
                    translation="[0, 0]"
                    itemComponentName="PosterItem"
                    numRows="2"
                    rowItemSize="[[140, 210]]"
                    rowItemSpacing="[[20, 0]]"
                    itemSize="[1728, 270]"
                    itemSpacing="[0, 16]"
                    showRowLabel="[true]"
                    rowLabelOffset="[[0, 8]]"
                    rowFocusAnimationStyle="fixedFocus"
                    focusXOffset="[0]"
                    drawFocusFeedback="false"
                />
            </Group>
        </Group>
    </children>
</component>
