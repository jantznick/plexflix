<?xml version="1.0" encoding="utf-8" ?>
<component name="DetailScreen" extends="Group">
    <interface>
        <field id="config" type="assocarray" />
        <field id="content" type="assocarray" onChange="onContentSet" />
        <field id="playRequested" type="assocarray" />
        <field id="openDetails" type="assocarray" />
        <field id="closed" type="boolean" alwaysNotify="true" />
        <field id="close" type="boolean" alwaysNotify="true" onChange="onCloseRequested" />
    </interface>

    <script type="text/brightscript" uri="DetailScreen.brs" />
    <script type="text/brightscript" uri="pkg:/source/Fonts.brs" />

    <children>
        <Rectangle width="1920" height="1080" color="0x07070B" />

        <Group id="frame" translation="[96, 64]">
            <Poster
                id="backdrop"
                width="1728"
                height="460"
                loadDisplayMode="scaleToZoom"
                opacity="0.28"
            />
            <Rectangle width="1728" height="460" color="0x07070B" opacity="0.5" />
            <Rectangle width="1728" height="700" translation="[0, 280]" color="0x07070B" opacity="0.96" />

            <!-- Poster with depth shadow -->
            <Rectangle width="208" height="312" translation="[8, 10]" color="0x000000" opacity="0.5" />
            <Poster
                id="poster"
                translation="[0, 0]"
                width="200"
                height="300"
                loadDisplayMode="scaleToZoom"
                uri="pkg:/images/poster_placeholder.png"
            />

            <Label id="titleLabel" translation="[248, 8]" width="1400" height="70" color="0xFFFFFF" wrap="true" maxLines="2">
                <Font role="font" uri="pkg:/fonts/Outfit-Bold.ttf" size="48" />
            </Label>
            <Label id="metaLabel" translation="[248, 86]" width="1400" height="32" color="0xA8A8B0">
                <Font role="font" uri="pkg:/fonts/Outfit-Medium.ttf" size="22" />
            </Label>
            <Label id="summaryLabel" translation="[248, 128]" width="1360" height="80" color="0xD0D0D6" wrap="true" maxLines="2" lineSpacing="5">
                <Font role="font" uri="pkg:/fonts/Outfit-Regular.ttf" size="22" />
            </Label>

            <Group id="movieActions" translation="[248, 228]" visible="true">
                <Group id="playBtn" translation="[0, 0]">
                    <Rectangle width="224" height="58" translation="[4, 4]" color="0x000000" opacity="0.45" />
                    <Rectangle id="playBg" width="220" height="56" color="0xE50914" />
                    <Label id="playLabel" width="220" height="56" horizAlign="center" vertAlign="center" text="Play" color="0xFFFFFF">
                        <Font role="font" uri="pkg:/fonts/Outfit-SemiBold.ttf" size="26" />
                    </Label>
                </Group>
                <Group id="backBtn" translation="[248, 0]">
                    <Rectangle id="backBg" width="160" height="56" color="0x24242C" />
                    <Label id="backLabel" width="160" height="56" horizAlign="center" vertAlign="center" text="Back" color="0xFFFFFF">
                        <Font role="font" uri="pkg:/fonts/Outfit-Medium.ttf" size="24" />
                    </Label>
                </Group>
            </Group>

            <Label id="softStatus" translation="[248, 300]" width="1200" height="28" text="" color="0x666670">
                <Font role="font" uri="pkg:/fonts/Outfit-Regular.ttf" size="18" />
            </Label>

            <Group id="tvPanel" translation="[0, 340]" visible="false">
                <RowList
                    id="seasonRows"
                    translation="[0, 0]"
                    itemComponentName="EpisodeItem"
                    numRows="2"
                    rowItemSize="[[300, 170]]"
                    rowItemSpacing="[[24, 0]]"
                    itemSize="[1728, 250]"
                    itemSpacing="[0, 28]"
                    showRowLabel="[true]"
                    rowLabelOffset="[[0, 8]]"
                    rowFocusAnimationStyle="fixedFocus"
                    focusXOffset="[0]"
                    drawFocusFeedback="false"
                />
            </Group>

            <Group id="relatedPanel" translation="[0, 340]" visible="false">
                <RowList
                    id="relatedRows"
                    translation="[0, 0]"
                    itemComponentName="PosterItem"
                    numRows="2"
                    rowItemSize="[[140, 210]]"
                    rowItemSpacing="[[20, 0]]"
                    itemSize="[1728, 280]"
                    itemSpacing="[0, 24]"
                    showRowLabel="[true]"
                    rowLabelOffset="[[0, 8]]"
                    rowFocusAnimationStyle="fixedFocus"
                    focusXOffset="[0]"
                    drawFocusFeedback="false"
                />
            </Group>
        </Group>
    </children>
</component>
