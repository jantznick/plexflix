<?xml version="1.0" encoding="utf-8" ?>
<component name="DetailScreen" extends="Group">
    <interface>
        <field id="config" type="assocarray" />
        <field id="content" type="assocarray" onChange="onContentSet" />
        <field id="playRequested" type="assocarray" />
        <field id="openDetails" type="assocarray" />
        <field id="closed" type="boolean" alwaysNotify="true" />
        <field id="close" type="boolean" alwaysNotify="true" onChange="onCloseRequested" />
    </interface>

    <script type="text/brightscript" uri="DetailScreen.brs" />
    <script type="text/brightscript" uri="pkg:/source/Fonts.brs" />

    <children>
        <Rectangle width="1920" height="1080" color="0x07070B" />

        <!-- Full-bleed hero — taller visible art plane -->
        <Poster
            id="backdrop"
            width="1920"
            height="680"
            loadDisplayMode="scaleToZoom"
            loadWidth="1920"
            loadHeight="1080"
            opacity="1"
        />
        <!-- Soft washes — stronger left panel so title/summary stay readable on busy art -->
        <Rectangle width="1920" height="680" color="0x07070B" opacity="0.18" />
        <Rectangle width="1100" height="680" color="0x07070B" opacity="0.52" />
        <Rectangle width="780" height="680" color="0x07070B" opacity="0.28" />
        <Rectangle width="1920" height="240" translation="[0, 440]" color="0x07070B" opacity="0.55" />
        <Rectangle width="1920" height="160" translation="[0, 560]" color="0x07070B" opacity="0.82" />

        <Group id="frame" translation="[96, 56]">
            <Rectangle width="216" height="324" translation="[8, 10]" color="0x000000" opacity="0.55" />
            <Poster
                id="poster"
                translation="[0, 0]"
                width="210"
                height="315"
                loadDisplayMode="scaleToZoom"
                uri="pkg:/images/poster_placeholder.png"
            />

            <Label id="titleLabel" translation="[248, 12]" width="1100" height="70" color="0xFFFFFF" wrap="true" maxLines="2">
                <Font role="font" uri="pkg:/fonts/Outfit-Bold.ttf" size="50" />
            </Label>
            <Label id="metaLabel" translation="[248, 92]" width="1100" height="32" color="0xD0D0D6">
                <Font role="font" uri="pkg:/fonts/Outfit-Medium.ttf" size="22" />
            </Label>
            <Label id="ratingLabel" translation="[248, 126]" width="1100" height="28" color="0xE5A00D" text="">
                <Font role="font" uri="pkg:/fonts/Outfit-Medium.ttf" size="20" />
            </Label>
            <Label id="summaryLabel" translation="[248, 158]" width="1000" height="72" color="0xFFFFFF" wrap="true" maxLines="2" lineSpacing="5">
                <Font role="font" uri="pkg:/fonts/Outfit-Regular.ttf" size="22" />
            </Label>
            <Label id="reviewLabel" translation="[248, 236]" width="1100" height="48" color="0xA8A8B2" wrap="true" maxLines="2" text="">
                <Font role="font" uri="pkg:/fonts/Outfit-Regular.ttf" size="18" />
            </Label>

            <!-- Shown for Discover titles that aren't in the local Plex library -->
            <Group id="unavailablePanel" translation="[248, 232]" visible="false">
                <Rectangle width="980" height="102" color="0x000000" opacity="0.35" translation="[4, 5]" />
                <Rectangle width="980" height="102" color="0x12121A" opacity="0.98" />
                <Rectangle width="6" height="102" color="0xE5A00D" />
                <Rectangle width="980" height="2" translation="[0, 0]" color="0xE5A00D" opacity="0.35" />
                <Label translation="[28, 16]" width="920" height="28" text="Not in your library" color="0xE5A00D">
                    <Font role="font" uri="pkg:/fonts/Outfit-SemiBold.ttf" size="18" />
                </Label>
                <Label id="unavailableBody" translation="[28, 48]" width="920" height="40" text="We don't have this one yet — but we can get it soon." color="0xF0F0F4" wrap="true" maxLines="1">
                    <Font role="font" uri="pkg:/fonts/Outfit-Regular.ttf" size="24" />
                </Label>
            </Group>

            <!-- Action row is laid out in code so optional buttons (From Start / Trailer / …) pack tightly -->
            <Group id="movieActions" translation="[248, 292]" visible="true">
                <Group id="playBtn" translation="[0, 0]">
                    <Rectangle id="playShadow" width="208" height="56" translation="[3, 4]" color="0x000000" opacity="0.45" />
                    <Rectangle id="playBg" width="200" height="52" color="0xE50914" />
                    <Label id="playLabel" width="200" height="52" horizAlign="center" vertAlign="center" text="Play" color="0xFFFFFF">
                        <Font role="font" uri="pkg:/fonts/Outfit-SemiBold.ttf" size="24" />
                    </Label>
                </Group>
                <Group id="startOverBtn" translation="[0, 0]" visible="false">
                    <Rectangle id="startOverShadow" width="208" height="56" translation="[3, 4]" color="0x000000" opacity="0.0" />
                    <Rectangle id="startOverBg" width="200" height="52" color="0x2A2A32" />
                    <Label id="startOverLabel" width="200" height="52" horizAlign="center" vertAlign="center" text="From Start" color="0xFFFFFF">
                        <Font role="font" uri="pkg:/fonts/Outfit-Medium.ttf" size="22" />
                    </Label>
                </Group>
                <Group id="trailerBtn" translation="[0, 0]" visible="false">
                    <Rectangle id="trailerShadow" width="178" height="56" translation="[3, 4]" color="0x000000" opacity="0.0" />
                    <Rectangle id="trailerBg" width="170" height="52" color="0x2A2A32" />
                    <Label id="trailerLabel" width="170" height="52" horizAlign="center" vertAlign="center" text="Trailer" color="0xFFFFFF">
                        <Font role="font" uri="pkg:/fonts/Outfit-Medium.ttf" size="22" />
                    </Label>
                </Group>
                <Group id="watchedBtn" translation="[0, 0]" visible="false">
                    <Rectangle id="watchedShadow" width="228" height="56" translation="[3, 4]" color="0x000000" opacity="0.0" />
                    <Rectangle id="watchedBg" width="220" height="52" color="0x2A2A32" />
                    <Label id="watchedLabel" width="220" height="52" horizAlign="center" vertAlign="center" text="Mark Watched" color="0xFFFFFF">
                        <Font role="font" uri="pkg:/fonts/Outfit-Medium.ttf" size="20" />
                    </Label>
                </Group>
                <Group id="watchlistBtn" translation="[0, 0]" visible="false">
                    <Rectangle id="watchlistShadow" width="308" height="56" translation="[3, 4]" color="0x000000" opacity="0.0" />
                    <Rectangle id="watchlistBg" width="300" height="52" color="0x2A2A32" />
                    <Label id="watchlistLabel" width="300" height="52" horizAlign="center" vertAlign="center" text="Add to Watchlist" color="0xFFFFFF">
                        <Font role="font" uri="pkg:/fonts/Outfit-SemiBold.ttf" size="22" />
                    </Label>
                </Group>
                <Group id="backBtn" translation="[0, 0]">
                    <Rectangle id="backShadow" width="148" height="56" translation="[3, 4]" color="0x000000" opacity="0.0" />
                    <Rectangle id="backBg" width="140" height="52" color="0x2A2A32" />
                    <Label id="backLabel" width="140" height="52" horizAlign="center" vertAlign="center" text="Back" color="0xFFFFFF">
                        <Font role="font" uri="pkg:/fonts/Outfit-Medium.ttf" size="22" />
                    </Label>
                </Group>
                <!-- Shows only — hidden for movies / unavailable Discover titles -->
                <Group id="randomBtn" translation="[0, 0]" visible="false">
                    <Rectangle id="randomShadow" width="178" height="56" translation="[3, 4]" color="0x000000" opacity="0.0" />
                    <Rectangle id="randomBg" width="170" height="52" color="0x2A2A32" />
                    <Label id="randomLabel" width="170" height="52" horizAlign="center" vertAlign="center" text="Random" color="0xFFFFFF">
                        <Font role="font" uri="pkg:/fonts/Outfit-Medium.ttf" size="22" />
                    </Label>
                </Group>
            </Group>

            <Label id="softStatus" translation="[248, 360]" width="1200" height="28" text="" color="0x666670">
                <Font role="font" uri="pkg:/fonts/Outfit-Regular.ttf" size="18" />
            </Label>

            <!-- Rails sit so next row can clip at bottom -->
            <Group id="tvPanel" translation="[0, 400]" visible="false">
                <ShelfRowList
                    id="seasonRows"
                    translation="[0, 0]"
                    itemComponentName="EpisodeItem"
                    numRows="2"
                    rowItemSize="[[360, 204]]"
                    rowItemSpacing="[[28, 0]]"
                    itemSize="[1728, 290]"
                    itemSpacing="[0, 20]"
                    showRowLabel="[true]"
                    rowLabelOffset="[[0, 8]]"
                    rowFocusAnimationStyle="fixedFocus"
                    vertFocusAnimationStyle="floatingFocus"
                    focusXOffset="[0]"
                    drawFocusFeedback="true"
                    drawFocusFeedbackOnTop="true"
                    focusBitmapUri="pkg:/images/focus_ring.9.png"
                    focusFootprintBlendColor="0x00000000"
                />
            </Group>

            <Group id="relatedPanel" translation="[0, 400]" visible="false">
                <ShelfRowList
                    id="relatedRows"
                    translation="[0, 0]"
                    itemComponentName="PosterItem"
                    numRows="2"
                    rowItemSize="[[168, 252]]"
                    rowItemSpacing="[[24, 0]]"
                    itemSize="[1728, 304]"
                    itemSpacing="[0, 8]"
                    showRowLabel="[true]"
                    rowLabelOffset="[[0, 8]]"
                    rowFocusAnimationStyle="fixedFocus"
                    vertFocusAnimationStyle="floatingFocus"
                    focusXOffset="[0]"
                    drawFocusFeedback="true"
                    drawFocusFeedbackOnTop="true"
                    focusBitmapUri="pkg:/images/focus_ring.9.png"
                    focusFootprintBlendColor="0x00000000"
                />
            </Group>
        </Group>
    </children>
</component>
