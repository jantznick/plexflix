<?xml version="1.0" encoding="utf-8" ?>
<component name="DetailScreen" extends="Group">
    <interface>
        <field id="config" type="assocarray" />
        <field id="content" type="assocarray" onChange="onContentSet" />
        <field id="playRequested" type="assocarray" />
        <field id="closed" type="boolean" alwaysNotify="true" />
        <field id="close" type="boolean" alwaysNotify="true" onChange="onCloseRequested" />
    </interface>

    <script type="text/brightscript" uri="DetailScreen.brs" />

    <children>
        <Rectangle width="1920" height="1080" color="0x0A0A0A" />

        <Poster
            id="backdrop"
            width="1920"
            height="1080"
            loadDisplayMode="scaleToFill"
            opacity="0.30"
        />
        <Rectangle width="1920" height="1080" color="0x0A0A0A" opacity="0.60" />

        <Poster
            id="poster"
            translation="[80, 120]"
            width="360"
            height="540"
            loadDisplayMode="scaleToZoom"
            uri="pkg:/images/poster_placeholder.png"
        />

        <Label
            id="titleLabel"
            translation="[500, 100]"
            width="1320"
            height="70"
            color="0xFFFFFF"
            font="font:LargeBoldSystemFont"
            wrap="true"
            maxLines="2"
        />
        <Label
            id="metaLabel"
            translation="[500, 180]"
            width="1320"
            height="36"
            color="0xB3B3B3"
            font="font:SmallSystemFont"
        />
        <Label
            id="summaryLabel"
            translation="[500, 230]"
            width="1280"
            height="110"
            color="0xD6D6D6"
            font="font:SmallSystemFont"
            wrap="true"
            maxLines="3"
            lineSpacing="4"
        />

        ' Movie actions
        <Group id="movieActions" translation="[500, 370]" visible="true">
            <Group id="playBtn" translation="[0, 0]">
                <Rectangle id="playBg" width="240" height="64" color="0xE50914" />
                <Label
                    id="playLabel"
                    width="240"
                    height="64"
                    horizAlign="center"
                    vertAlign="center"
                    text="Play"
                    color="0xFFFFFF"
                    font="font:MediumBoldSystemFont"
                />
            </Group>
            <Group id="backBtn" translation="[260, 0]">
                <Rectangle id="backBg" width="180" height="64" color="0x2A2A2A" />
                <Label
                    id="backLabel"
                    width="180"
                    height="64"
                    horizAlign="center"
                    vertAlign="center"
                    text="Back"
                    color="0xFFFFFF"
                    font="font:MediumSystemFont"
                />
            </Group>
        </Group>

        ' TV show browse
        <Group id="tvPanel" translation="[500, 360]" visible="false">
            <Label
                id="seasonHeading"
                width="400"
                height="36"
                text="Seasons"
                color="0xFFFFFF"
                font="font:SmallBoldSystemFont"
            />
            <LabelList
                id="seasonList"
                translation="[0, 40]"
                itemSize="[320, 52]"
                itemSpacing="[0, 6]"
                numRows="8"
                color="0xCCCCCC"
                focusedColor="0xFFFFFF"
                drawFocusFeedback="true"
            />

            <Label
                id="episodeHeading"
                translation="[360, 0]"
                width="900"
                height="36"
                text="Episodes"
                color="0xFFFFFF"
                font="font:SmallBoldSystemFont"
            />
            <LabelList
                id="episodeList"
                translation="[360, 40]"
                itemSize="[980, 56]"
                itemSpacing="[0, 4]"
                numRows="9"
                color="0xCCCCCC"
                focusedColor="0xFFFFFF"
                drawFocusFeedback="true"
            />

            <Label
                id="tvHint"
                translation="[0, 520]"
                width="1340"
                height="40"
                text="Left/Right switch lists  •  OK plays episode  •  Back returns"
                color="0x808080"
                font="font:SmallestSystemFont"
            />
        </Group>

        <Label
            id="statusLabel"
            translation="[500, 980]"
            width="1300"
            height="40"
            text=""
            color="0xAAAAAA"
            font="font:SmallestSystemFont"
        />
    </children>
</component>
