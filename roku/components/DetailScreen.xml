<?xml version="1.0" encoding="utf-8" ?>
<component name="DetailScreen" extends="Group">
    <interface>
        <field id="config" type="assocarray" />
        <field id="content" type="assocarray" onChange="onContentSet" />
        <field id="playRequested" type="assocarray" />
        <field id="closed" type="boolean" alwaysNotify="true" />
        <field id="close" type="boolean" alwaysNotify="true" onChange="onCloseRequested" />
    </interface>

    <script type="text/brightscript" uri="DetailScreen.brs" />

    <children>
        <Rectangle width="1920" height="1080" color="0x0A0A0A" />

        <Poster
            id="backdrop"
            width="1920"
            height="1080"
            loadDisplayMode="scaleToFill"
            opacity="0.28"
        />
        <Rectangle width="1920" height="1080" color="0x0A0A0A" opacity="0.62" />

        <Poster
            id="poster"
            translation="[80, 80]"
            width="300"
            height="450"
            loadDisplayMode="scaleToZoom"
            uri="pkg:/images/poster_placeholder.png"
        />

        <Label
            id="titleLabel"
            translation="[440, 80]"
            width="1400"
            height="70"
            color="0xFFFFFF"
            font="font:LargeBoldSystemFont"
            wrap="true"
            maxLines="2"
        />
        <Label
            id="metaLabel"
            translation="[440, 160]"
            width="1400"
            height="36"
            color="0xB3B3B3"
            font="font:SmallSystemFont"
        />
        <Label
            id="summaryLabel"
            translation="[440, 210]"
            width="1360"
            height="100"
            color="0xD6D6D6"
            font="font:SmallSystemFont"
            wrap="true"
            maxLines="3"
            lineSpacing="4"
        />

        <Group id="movieActions" translation="[440, 340]" visible="true">
            <Group id="playBtn" translation="[0, 0]">
                <Rectangle id="playBg" width="240" height="64" color="0xE50914" />
                <Label
                    id="playLabel"
                    width="240"
                    height="64"
                    horizAlign="center"
                    vertAlign="center"
                    text="Play"
                    color="0xFFFFFF"
                    font="font:MediumBoldSystemFont"
                />
            </Group>
            <Group id="backBtn" translation="[268, 0]">
                <Rectangle id="backBg" width="180" height="64" color="0x2A2A2A" />
                <Label
                    id="backLabel"
                    width="180"
                    height="64"
                    horizAlign="center"
                    vertAlign="center"
                    text="Back"
                    color="0xFFFFFF"
                    font="font:MediumSystemFont"
                />
            </Group>
        </Group>

        <Group id="tvPanel" translation="[0, 340]" visible="false">
            <RowList
                id="seasonRows"
                translation="[0, 0]"
                itemComponentName="EpisodeItem"
                numRows="3"
                rowItemSize="[[320, 180]]"
                rowItemSpacing="[[24, 0]]"
                itemSize="[1920, 240]"
                itemSpacing="[0, 20]"
                showRowLabel="[true]"
                rowLabelOffset="[[80, 6]]"
                rowFocusAnimationStyle="fixedFocus"
                focusXOffset="[80]"
                drawFocusFeedback="false"
            />
        </Group>
    </children>
</component>
