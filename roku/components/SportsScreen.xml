<?xml version="1.0" encoding="utf-8" ?>
<component name="SportsScreen" extends="Group">
    <interface>
        <field id="config" type="assocarray" onChange="onConfigReady" />
        <field id="selectedItem" type="assocarray" />
        <field id="loadingMessage" type="string" />
        <field id="openMenu" type="boolean" alwaysNotify="true" />
        <field id="refocus" type="boolean" alwaysNotify="true" onChange="onRefocus" />
        <!-- Multiview picks live here so they survive filters and the game
             page; the game page reaches them through MainScene -->
        <field id="multiviewToggle" type="assocarray" alwaysNotify="true" onChange="onMultiviewToggle" />
        <field id="launchMultiview" type="boolean" alwaysNotify="true" onChange="onLaunchMultiview" />
        <field id="multiviewMessage" type="string" alwaysNotify="true" />
        <field id="multiviewRequested" type="assocarray" />
    </interface>

    <script type="text/brightscript" uri="SportsScreen.brs" />
    <script type="text/brightscript" uri="pkg:/source/Fonts.brs" />

    <children>
        <Rectangle width="1920" height="1080" color="0x0A0E18" />

        <Rectangle width="1920" height="96" color="0x121A2A" />
        <Label translation="[96, 20]" width="900" height="56" vertAlign="center" text="LIVE SPORTS GUIDE" color="0xE50914">
            <Font role="font" uri="pkg:/fonts/Outfit-Bold.ttf" size="44" />
        </Label>
        <Label id="clockLabel" translation="[1224, 20]" width="600" height="56" horizAlign="right" vertAlign="center" text="" color="0xA8B0C0">
            <Font role="font" uri="pkg:/fonts/Outfit-Medium.ttf" size="36" />
        </Label>

        <!-- Sport filter pills: All + one per feed category. Clipped so a long
             category list scrolls sideways instead of running off screen -->
        <Group id="pillClip" translation="[96, 112]" clippingRect="[0, 0, 1728, 56]">
            <Group id="pillRow" />
        </Group>

        <Group translation="[96, 184]">
            <Label id="eventTitle" width="900" height="60" color="0xFFFFFF" wrap="true" maxLines="1" text="Select a game">
                <Font role="font" uri="pkg:/fonts/Outfit-Bold.ttf" size="48" />
            </Label>
            <Label id="eventMeta" translation="[0, 66]" width="900" height="40" color="0x8FA0B8" text="">
                <Font role="font" uri="pkg:/fonts/Outfit-Medium.ttf" size="30" />
            </Label>
            <Label id="eventSummary" translation="[0, 110]" width="900" height="40" color="0xC5CCD8" wrap="true" maxLines="1" text="">
                <Font role="font" uri="pkg:/fonts/Outfit-Regular.ttf" size="28" />
            </Label>
            <Label id="statusLabel" translation="[0, 156]" width="900" height="36" text="" color="0x778099">
                <Font role="font" uri="pkg:/fonts/Outfit-Regular.ttf" size="26" />
            </Label>

            <!-- height=196, width=196*(16/9)=348 -->
            <Rectangle id="previewBg" translation="[1020, 0]" width="348" height="196" color="0x111820" />
            <Poster
                id="previewArt"
                translation="[1020, 0]"
                width="348"
                height="196"
                loadDisplayMode="scaleToZoom"
                loadWidth="1280"
                loadHeight="720"
                uri="pkg:/images/poster_placeholder.png"
                opacity="0.5"
            />

            <!-- Right of the preview art; hidden unless multiviewUrl is set -->
            <Group id="multiTray" translation="[1404, 0]" visible="false">
                <Rectangle width="324" height="196" color="0x121A2A" />
                <Rectangle width="324" height="4" color="0xE50914" />
                <Label id="multiCount" translation="[18, 14]" width="290" height="32" color="0xFFFFFF" text="MULTIVIEW  0/4">
                    <Font role="font" uri="pkg:/fonts/Outfit-Bold.ttf" size="24" />
                </Label>
                <Label id="multiList" translation="[18, 50]" width="290" height="104" color="0xC5CCD8" wrap="true" maxLines="4" text="">
                    <Font role="font" uri="pkg:/fonts/Outfit-Medium.ttf" size="20" />
                </Label>
                <Label id="multiHint" translation="[18, 158]" width="290" height="28" color="0x8FA0B8" text="">
                    <Font role="font" uri="pkg:/fonts/Outfit-Regular.ttf" size="19" />
                </Label>
            </Group>
        </Group>

        <Rectangle translation="[0, 392]" width="1920" height="56" color="0x1A2438" />
        <Label translation="[96, 400]" width="300" height="40" vertAlign="center" text="LEAGUE" color="0x8FA0B8">
            <Font role="font" uri="pkg:/fonts/Outfit-SemiBold.ttf" size="32" />
        </Label>
        <Label translation="[412, 400]" width="900" height="40" vertAlign="center" text="EVENT" color="0xE8EEF8">
            <Font role="font" uri="pkg:/fonts/Outfit-SemiBold.ttf" size="32" />
        </Label>
        <Label translation="[1332, 400]" width="500" height="40" vertAlign="center" text="STREAMS" color="0x8FA0B8">
            <Font role="font" uri="pkg:/fonts/Outfit-SemiBold.ttf" size="32" />
        </Label>

        <EscapeMarkupList
            id="guideList"
            translation="[72, 456]"
            itemComponentName="GuideRowItem"
            itemSize="[1776, 84]"
            itemSpacing="[0, 4]"
            numRows="7"
            vertFocusAnimationStyle="floatingFocus"
            drawFocusFeedback="false"
        />
    </children>
</component>
